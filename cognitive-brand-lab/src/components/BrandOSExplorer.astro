---
import { getLocalizedPath, type Lang } from '../utils/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const isEn = lang === 'en';
---

<section class="max-w-6xl mx-auto px-5 md:px-8 py-20 relative z-10 border-b border-[#232B3E]" id="brandos-matrix">
  <!-- Section Title -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-[#232B3E] pb-6">
    <div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-cyan-950/40 border border-cyan-800/40 rounded-full font-mono text-[11px] font-bold text-cyan-400 uppercase tracking-[0.2em] mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        INTERACTIVE SYSTEM EXPLORER
      </div>
      <h2 class="font-sans font-extrabold text-[28px] sm:text-[42px] text-slate-100 leading-tight">
        {isEn ? 'BrandOS™ Architecture Console' : 'BrandOS™ 品牌操作系统建设'}
      </h2>
    </div>
    <p class="text-slate-400 text-[14px] sm:text-[15px] mt-3 md:mt-0 font-sans max-w-md">
      {isEn ? (
        <>Select any of the 6 modules below to inspect its <span class="text-cyan-400 font-semibold">scientific mechanism</span>, benchmark case study, and financial outcomes.</>
      ) : (
        <>点击下方 6 大阶段，切换查看各模块的<span class="text-cyan-400 font-semibold">可视化科学模型</span>、真实实战战例与量化财务战果。</>
      )}
    </p>
  </div>

  <!-- Interactive 6-Tab Stepper -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 mb-8">
    <button class="os-tab-btn active p-3 rounded-lg border border-cyan-500 bg-cyan-950/30 text-left transition-all group" data-tab="m1">
      <div class="flex items-center justify-between font-mono text-[11px] mb-1">
        <span class="font-black text-cyan-400">01</span>
        <span class="text-cyan-300 text-[10px] uppercase">RADAR</span>
      </div>
      <div class="font-bold text-slate-100 text-[14px]">{isEn ? 'M1 Demand Radar' : 'M1 勘测心智'}</div>
      <div class="text-[11px] text-slate-400 mt-0.5 truncate">{isEn ? 'EcoFlow Storm Pivot' : 'EcoFlow 暴风雪应急'}</div>
    </button>

    <button class="os-tab-btn p-3 rounded-lg border border-[#232B3E] bg-[#111622] text-left transition-all hover:border-slate-500 group" data-tab="m2">
      <div class="flex items-center justify-between font-mono text-[11px] mb-1">
        <span class="font-black text-indigo-400">02</span>
        <span class="text-indigo-300 text-[10px] uppercase">TRUST</span>
      </div>
      <div class="font-bold text-slate-200 text-[14px]">{isEn ? 'M2 Unfakeable Trust' : 'M2 立住人设'}</div>
      <div class="text-[11px] text-slate-400 mt-0.5 truncate">{isEn ? 'Dyson 5,127 Prototypes' : 'Dyson 5127次打样'}</div>
    </button>

    <button class="os-tab-btn p-3 rounded-lg border border-[#232B3E] bg-[#111622] text-left transition-all hover:border-slate-500 group" data-tab="m3">
      <div class="flex items-center justify-between font-mono text-[11px] mb-1">
        <span class="font-black text-emerald-400">03</span>
        <span class="text-emerald-300 text-[10px] uppercase">PRICING</span>
      </div>
      <div class="font-bold text-slate-200 text-[14px]">{isEn ? 'M3 Value Pricing' : 'M3 价值定价'}</div>
      <div class="text-[11px] text-slate-400 mt-0.5 truncate">{isEn ? 'YETI 65%+ Margin' : 'YETI 65%+ 战略毛利'}</div>
    </button>

    <button class="os-tab-btn p-3 rounded-lg border border-[#232B3E] bg-[#111622] text-left transition-all hover:border-slate-500 group" data-tab="m4">
      <div class="flex items-center justify-between font-mono text-[11px] mb-1">
        <span class="font-black text-amber-400">04</span>
        <span class="text-amber-300 text-[10px] uppercase">ALGO</span>
      </div>
      <div class="font-bold text-slate-200 text-[14px]">{isEn ? 'M4 Algo Resonance' : 'M4 算法共振'}</div>
      <div class="text-[11px] text-slate-400 mt-0.5 truncate">{isEn ? 'HexClad Whitelisting' : 'HexClad 白标买爆'}</div>
    </button>

    <button class="os-tab-btn p-3 rounded-lg border border-[#232B3E] bg-[#111622] text-left transition-all hover:border-slate-500 group" data-tab="m5">
      <div class="flex items-center justify-between font-mono text-[11px] mb-1">
        <span class="font-black text-rose-400">05</span>
        <span class="text-rose-300 text-[10px] uppercase">CONVERT</span>
      </div>
      <div class="font-bold text-slate-200 text-[14px]">{isEn ? 'M5 Rapid Convert' : 'M5 极速转化'}</div>
      <div class="text-[11px] text-slate-400 mt-0.5 truncate">{isEn ? 'Ridge 100px Proof' : 'Gymshark 100px 证据'}</div>
    </button>

    <button class="os-tab-btn p-3 rounded-lg border border-[#232B3E] bg-[#111622] text-left transition-all hover:border-slate-500 group" data-tab="m6">
      <div class="flex items-center justify-between font-mono text-[11px] mb-1">
        <span class="font-black text-purple-400">06</span>
        <span class="text-purple-300 text-[10px] uppercase">COMPOUND</span>
      </div>
      <div class="font-bold text-slate-200 text-[14px]">{isEn ? 'M6 Retention' : 'M6 复利留存'}</div>
      <div class="text-[11px] text-slate-400 mt-0.5 truncate">{isEn ? 'Chewy 80% Autoship' : 'Chewy 80% 自动订阅'}</div>
    </button>
  </div>

  <!-- Interactive Display Console -->
  <div class="bg-[#111622] border border-[#232B3E] rounded-2xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
    <div class="absolute top-3 right-4 font-mono text-[10px] text-slate-600 select-none">BrandOS™ CONSOLE // REAL-WORLD CASES</div>

    <!-- PANEL M1: EcoFlow -->
    <div class="os-panel active grid grid-cols-1 lg:grid-cols-12 gap-8 items-center" id="panel-m1">
      <div class="lg:col-span-6 bg-[#09090B] border border-cyan-500/40 rounded-xl p-5 sm:p-6 relative overflow-hidden shadow-[0_0_30px_rgba(0,242,254,0.06)]">
        <div class="flex justify-between items-center mb-4 pb-3 border-b border-[#232B3E]">
          <span class="font-mono text-[11px] text-cyan-400 font-bold uppercase">{isEn ? '5W1H CEP DEMAND RADAR SCAN' : '5W1H 需求与场景雷达扫描'}</span>
          <span class="font-mono text-[10px] text-slate-500">ECOFLOW 25,000+ VOC</span>
        </div>

        <div class="relative w-full aspect-[4/3] flex items-center justify-center">
          <svg class="w-full h-full max-h-[260px]" viewBox="0 0 300 240" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="150" cy="120" r="100" stroke="#232B3E" stroke-width="1" stroke-dasharray="3 3" />
            <circle cx="150" cy="120" r="70" stroke="#232B3E" stroke-width="1" />
            <circle cx="150" cy="120" r="40" stroke="#232B3E" stroke-width="1" />
            <line x1="150" y1="20" x2="150" y2="220" stroke="#232B3E" stroke-width="1" />
            <line x1="50" y1="120" x2="250" y2="120" stroke="#232B3E" stroke-width="1" />
            <path d="M150 120 L240 70 A100 100 0 0 0 150 20 Z" fill="url(#radar-gradient)" opacity="0.4" />
            <g class="animate-pulse">
              <circle cx="195" cy="65" r="7" fill="#00F2FE" />
              <circle cx="195" cy="65" r="14" stroke="#00F2FE" stroke-width="1" opacity="0.6" />
              <text x={isEn ? "195" : "210"} y={isEn ? "44" : "70"} fill="#00F2FE" font-family="JetBrains Mono" font-size={isEn ? "9" : "10"} font-weight="bold" text-anchor={isEn ? "middle" : "start"}>
                {isEn ? 'Storm Backup (Tier-1 White Space)' : '暴风雪全屋应急备电 (Tier-1 空白)'}
              </text>
              <circle cx="100" cy="160" r="5" fill="#EF4444" />
              <text x="110" y="164" fill="#EF4444" font-family="JetBrains Mono" font-size={isEn ? "8.5" : "9"}>
                {isEn ? 'Camping Packs (Red Ocean Price War)' : '露营烧烤 (红海内卷·杀价泥潭)'}
              </text>
              <circle cx="190" cy="170" r="5" fill="#10B981" />
              <text x={isEn ? "150" : "120"} y="200" fill="#94A3B8" font-family="JetBrains Mono" font-size={isEn ? "8.5" : "9"} text-anchor={isEn ? "middle" : "start"}>
                {isEn ? '1-Hr X-Stream Charge (100% Review Fix)' : 'X-Stream 1小时快充 (差评解决率 100%)'}
              </text>
            </g>
            <defs>
              <radialGradient id="radar-gradient" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(150 120) rotate(45) scale(100)">
                <stop stop-color="#00F2FE" stop-opacity="0.8"/>
                <stop offset="1" stop-color="#00F2FE" stop-opacity="0"/>
              </radialGradient>
            </defs>
          </svg>
        </div>

        <div class="mt-3 pt-3 border-t border-[#232B3E] flex justify-between items-center font-mono text-[11px]">
          <span class="text-slate-400">
            {isEn ? (<>VOC Fault Line: <strong class="text-cyan-400">8-Hr Charge Fails in Emergencies</strong></>) : (<>差评断层发现：<strong class="text-cyan-400">传统充电需8小时遇灾即瘫痪</strong></>)}
          </span>
          <span class="text-emerald-400 font-bold">{isEn ? 'Crowdfund: $12.11M' : '众筹纪录: $12.11M'}</span>
        </div>
      </div>

      <div class="lg:col-span-6 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 bg-cyan-950/80 border border-cyan-800/60 rounded text-cyan-400 font-mono text-[11px] font-bold uppercase mb-3">
            STAGE 01 // DEMAND RADAR
          </div>
          <h3 class="font-sans font-bold text-[24px] sm:text-[28px] text-slate-100 mb-2">
            {isEn
              ? 'M1 Demand Radar: Mine Real Review Fault Lines Before Launching SKUs'
              : 'M1 勘测心智：别盲目测款，用 AI 挖出海外差评断层'}
          </h3>
          <p class="text-slate-300 text-[15px] leading-relaxed mb-6 font-sans">
            {isEn
              ? 'Stop guessing trending gadgets. Cluster tens of thousands of Reddit and Amazon negative reviews into 5W1H jobs-to-be-done to lock in uncontested buying triggers giants overlook.'
              : '彻底告别盲目测款和粗暴铺货。通过抓取海外 Reddit 与 Amazon 数万条差评，用 AI 深度聚类出买家最痛却没人解决的 5W1H 刚需场景，开辟巨头看不见的场景蓝海。'}
          </p>

          <div class="space-y-3.5 mb-6">
            <div class="flex items-start gap-3 bg-[#09090B] p-3.5 rounded-lg border border-[#232B3E]">
              <span class="text-cyan-400 font-mono font-bold text-[14px]">01</span>
              <div>
                <div class="font-bold text-slate-200 text-[13px]">
                  {isEn ? 'Case Study: EcoFlow Portable Power Repositioning' : '实证战例：EcoFlow 正浩便携储能品类重锚'}
                </div>
                <div class="text-slate-400 text-[12.5px] mt-0.5">
                  {isEn
                    ? 'Exited crowded weekend camping packs to own 2021 Texas blackout home backup, engineering 1-hour X-Stream fast charging around acute outage anxiety.'
                    : '从“周末露营小电宝”跳出，锁定 2021 德州暴风雪“全屋极寒应急备电”，开发 1 小时快充专利彻底解决差评痛点。'}
                </div>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-[#09090B] p-3.5 rounded-lg border border-[#232B3E]">
              <span class="text-emerald-400 font-mono font-bold text-[14px]">02</span>
              <div>
                <div class="font-bold text-slate-200 text-[13px]">
                  {isEn ? 'Financial Impact: Record Launch & $1B Scale' : '财务成果：众筹破纪录与 10 亿美元跨越'}
                </div>
                <div class="text-slate-400 text-[12.5px] mt-0.5">
                  {isEn
                    ? 'Raised $12.11M on Kickstarter, lifted ASP from $299 to $3,599+, and scaled annual revenue from $15M past $1B.'
                    : 'Kickstarter 狂揽 $12.11M 创全球科技众筹纪录；客单价从 $299 跃升至 $3599+；年营收从 $1500 万爆发突破 10 亿美元。'}
                </div>
              </div>
            </div>
          </div>
        </div>

        <a href={getLocalizedPath('/modules/m1-brand-foundations', lang)} class="inline-flex items-center gap-2 font-mono text-[13px] font-bold text-cyan-400 hover:text-cyan-300 transition-colors">
          <span>{isEn ? 'Explore M1 Engineering Deep Dive' : '进入 M1 深度工程解析'}</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- PANEL M2: Patagonia & Dyson -->
    <div class="os-panel hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-center" id="panel-m2">
      <div class="lg:col-span-6 bg-[#09090B] border border-indigo-500/40 rounded-xl p-5 sm:p-6 relative overflow-hidden shadow-[0_0_30px_rgba(99,102,241,0.06)]">
        <div class="flex justify-between items-center mb-4 pb-3 border-b border-[#232B3E]">
          <span class="font-mono text-[11px] text-indigo-400 font-bold uppercase">{isEn ? 'SPENCE COSTLY SIGNALING EQUILIBRIUM' : '斯宾塞昂贵信号与分离均衡'}</span>
          <span class="font-mono text-[10px] text-slate-500">DYSON & PATAGONIA</span>
        </div>

        <div class="relative w-full aspect-[4/3] flex items-center justify-center">
          <svg class="w-full h-full max-h-[260px]" viewBox="0 0 300 240" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="40" y1="200" x2="260" y2="200" stroke="#232B3E" stroke-width="2" />
            <polygon points="150,200 140,220 160,220" fill="#27272A" />
            <line x1="50" y1="170" x2="250" y2="130" stroke="#00F2FE" stroke-width="3" stroke-linecap="round" />
            <g transform={isEn ? "translate(46, 158)" : "translate(60, 160)"}>
              <rect width={isEn ? "86" : "60"} height="35" rx="6" fill="#111622" stroke="#EF4444" stroke-width="1.5"/>
              <text x={isEn ? "43" : "30"} y="17" fill="#EF4444" font-family="JetBrains Mono" font-size={isEn ? "8" : "9"} font-weight="bold" text-anchor="middle">
                {isEn ? 'Cheap Ad Claims' : '口头自夸'}
              </text>
              <text x={isEn ? "43" : "30"} y="28" fill="#94A3B8" font-family="JetBrains Mono" font-size="7.5" text-anchor="middle">
                {isEn ? '$0 Cost • Zero Trust' : '$0 成本 / 零信任'}
              </text>
            </g>
            <g transform={isEn ? "translate(162, 95)" : "translate(180, 100)"}>
              <rect width={isEn ? "104" : "80"} height="44" rx="6" fill="#111622" stroke="#00F2FE" stroke-width="1.5"/>
              <text x={isEn ? "52" : "40"} y="16" fill="#00F2FE" font-family="JetBrains Mono" font-size={isEn ? "8.5" : "9"} font-weight="bold" text-anchor="middle">
                {isEn ? 'Costly Signaling' : '昂贵信号质押'}
              </text>
              <text x={isEn ? "52" : "40"} y="27" fill="#E2E8F0" font-family="JetBrains Mono" font-size="7.2" text-anchor="middle">
                {isEn ? '5,127 Tests • Clear Bin' : '5127次原型/全透明仓'}
              </text>
              <text x={isEn ? "52" : "40"} y="38" fill="#10B981" font-family="JetBrains Mono" font-size="7.5" font-weight="bold" text-anchor="middle">
                {isEn ? '+100% Price Power' : '+100% 溢价抢购'}
              </text>
            </g>
          </svg>
        </div>

        <div class="mt-3 pt-3 border-t border-[#232B3E] flex justify-between items-center font-mono text-[11px]">
          <span class="text-slate-400">
            {isEn ? (<>Moat Mechanism: <strong class="text-indigo-400">Uncopiable Sunk Proof</strong></>) : (<>公信力机制：<strong class="text-indigo-400">假冒者模仿即破产的沉没质押</strong></>)}
          </span>
          <span class="text-emerald-400 font-bold">{isEn ? 'Counter-Promo Lift: +30%' : '反向营销增收: +30%'}</span>
        </div>
      </div>

      <div class="lg:col-span-6 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 bg-indigo-950/80 border border-indigo-800/60 rounded text-indigo-400 font-mono text-[11px] font-bold uppercase mb-3">
            STAGE 02 // UNFAKEABLE TRUST
          </div>
          <h3 class="font-sans font-bold text-[24px] sm:text-[28px] text-slate-100 mb-2">
            {isEn
              ? 'M2 Unfakeable Trust: Replace Hollow Slogans With Verifiable Proof'
              : 'M2 立住人设：口头吹嘘没人信，用极端实测彻底破除防备'}
          </h3>
          <p class="text-slate-300 text-[15px] leading-relaxed mb-6 font-sans">
            {isEn
              ? 'Writing “premium quality” costs zero dollars—and buys zero credibility. Anchor your storefront on accredited lab audits, decade-long warranties, and destructive torture tests copycats cannot afford.'
              : '打字写“品质优良”一文不值。用假冒者模仿即破产的高成本投入（国际权威认证、10 年包换、极限破坏性实测），在独立站建立不可动摇的公信力护城河。'}
          </p>

          <div class="space-y-3.5 mb-6">
            <div class="flex items-start gap-3 bg-[#09090B] p-3.5 rounded-lg border border-[#232B3E]">
              <span class="text-indigo-400 font-mono font-bold text-[14px]">01</span>
              <div>
                <div class="font-bold text-slate-200 text-[13px]">
                  {isEn ? 'Case Study: Patagonia "Don’t Buy This Jacket"' : '实证战例：Patagonia《不要买这件夹克》反向营销'}
                </div>
                <div class="text-slate-400 text-[12.5px] mt-0.5">
                  {isEn
                    ? 'Built North America’s largest apparel repair hub (100k items/yr) and pledged 1% of sales, turning radical consistency into cult loyalty (+30% YoY revenue).'
                    : '自建北美最大维修工厂年修 10 万件旧衣，坚持 1% 刚性收入捐赠，2022 年将 $30 亿股权全部捐赠，换来全球不可动摇的狂热崇拜。'}
                </div>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-[#09090B] p-3.5 rounded-lg border border-[#232B3E]">
              <span class="text-emerald-400 font-mono font-bold text-[14px]">02</span>
              <div>
                <div class="font-bold text-slate-200 text-[13px]">
                  {isEn ? 'Case Study: Dyson 5,127 Prototypes & Clear Cyclone DBA' : '实证战例：Dyson 戴森 5,127 次原型与透明气旋指纹'}
                </div>
                <div class="text-slate-400 text-[12.5px] mt-0.5">
                  {isEn
                    ? 'Engineered 5,127 hand-built prototypes and showcased transparent polycarbonate dustbins so physics became visible—commanding 3x–5x pricing and 25%–30% EBITDA.'
                    : '手工打磨 5,127 个原型抵押房产，首创全透明航空聚碳酸酯集尘仓，让技术肉眼可见，吸尘器售价 3-5 倍于竞品，EBITDA 达 25%-30%。'}
                </div>
              </div>
            </div>
          </div>
        </div>

        <a href={getLocalizedPath('/modules/m2-behavioral-science', lang)} class="inline-flex items-center gap-2 font-mono text-[13px] font-bold text-indigo-400 hover:text-indigo-300 transition-colors">
          <span>{isEn ? 'Explore M2 Engineering Deep Dive' : '进入 M2 深度工程解析'}</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- PANEL M3: YETI -->
    <div class="os-panel hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-center" id="panel-m3">
      <div class="lg:col-span-6 bg-[#09090B] border border-emerald-500/40 rounded-xl p-5 sm:p-6 relative overflow-hidden shadow-[0_0_30px_rgba(168,85,247,0.06)]">
        <div class="flex justify-between items-center mb-4 pb-3 border-b border-[#232B3E]">
          <span class="font-mono text-[11px] text-emerald-400 font-bold uppercase">{isEn ? 'GOOD-BETTER-BEST PRICING LADDER' : 'Good-Better-Best 3 档阶梯定价模型'}</span>
          <span class="font-mono text-[10px] text-slate-500">YETI 65%+ GROSS MARGIN</span>
        </div>

        <div class="relative w-full aspect-[4/3] flex items-center justify-center">
          <svg class="w-full h-full max-h-[260px]" viewBox="0 0 300 240" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g transform="translate(26, 130)">
              <rect width="70" height="80" rx="4" fill="#111622" stroke="#232B3E" stroke-width="1.5" />
              <text x="35" y="24" fill="#94A3B8" font-family="JetBrains Mono" font-size="9" text-anchor="middle" font-weight="bold">GOOD</text>
              <text x="35" y="42" fill="#E2E8F0" font-family="JetBrains Mono" font-size="12" text-anchor="middle" font-weight="bold">$250</text>
              <text x="35" y="60" fill="#64748B" font-family="JetBrains Mono" font-size="7.5" text-anchor="middle">{isEn ? 'Entry Gateway' : '降低尝试摩擦'}</text>
            </g>
            <g transform="translate(110, 80)">
              <rect width="80" height="130" rx="6" fill="#111622" stroke="#10B981" stroke-width="2" />
