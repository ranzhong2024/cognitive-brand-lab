---
import Layout from '../../layouts/Layout.astro';
import AntithesisMatrix from '../AntithesisMatrix.astro';
import BrandOSPipeline from '../BrandOSPipeline.astro';
import EssayCard from '../EssayCard.astro';
import { getCollection } from 'astro:content';
import { getEssaySlug, getLocalizedPath, type Lang } from '../../utils/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const isEn = lang === 'en';

const homeCustomSchema = {
  "@type": "FAQPage",
  "@id": isEn ? "https://ranbrandos.com/en/#faq-brandos" : "https://ranbrandos.com/#faq-brandos",
  "inLanguage": isEn ? "en" : "zh-CN",
  "name": isEn
    ? "BrandOS™ Global Brand Operating System Core FAQ"
    : "BrandOS™ 全球品牌操作系统核心高意图常见问答",
  "mainEntity": isEn
    ? [
        {
          "@type": "Question",
          "name": "What is BrandOS™, and how is it fundamentally different from traditional paid-traffic arbitrage and OEM selling?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BrandOS™ is an engineering operating system built to create high-margin global DTC brands from zero to one. Traditional cross-border selling relies on cost-plus pricing and daily platform ad arbitrage, which collapses whenever CPMs rise. BrandOS™ unifies six causally linked modules (M1 Demand Radar, M2 Unfakeable Trust, M3 Strategic Value Pricing, M4 Algorithmic Resonance, M5 Rapid Conversion, M6 Compounding Retention) powered by CBAP business analysis, Spence costly signaling, and Rubin causal incrementality."
          }
        },
        {
          "@type": "Question",
          "name": "Why does BrandOS™ enforce a 65%+ Blended Pocket Gross Margin threshold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Below 65% pocket gross margin, DTC brands lose resilience against rising ad auction costs, fulfillment inflation, and tariff pressure. BrandOS™ uses M2 costly signaling to elevate willingness-to-pay (WTP), structures Good-Better-Best tiers (capturing ~70% unit volume on a 68%–72% margin Hero SKU), and caps price-waterfall leakage at <=15% so cash flow compounds into R&D and brand equity."
          }
        },
        {
          "@type": "Question",
          "name": "What is Costly Signaling Theory, and how does an emerging brand overcome cross-border skepticism?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Originating with Nobel laureate Michael Spence, Costly Signaling proves that cheap claims ('100% Top Quality') carry zero weight in asymmetric markets. Only verifiable, high-sunk-cost commitments that dishonest copycats would go bankrupt trying to imitate establish trust: independent lab certifications (UL, TUV, SGS), destructive torture-test footage, and 5-to-10-year warranties surfaced in a dedicated Proof Center."
          }
        },
        {
          "@type": "Question",
          "name": "Why is high platform-reported ROAS (e.g., 4.0+) often misleading compared to Causal Incrementality (iROAS)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Platform ad dashboards claim credit via correlational attribution—frequently double-counting branded searchers and existing customers who would have converted organically. M6 applies Donald Rubin's potential-outcomes framework through Holdout Geo-Lift tests: iROAS = (Treatment Revenue - Counterfactual Baseline) / Incremental Ad Spend. BrandOS™ targets true iROAS >= 1.20 alongside storewide MER of 3.5–5.0."
          }
        },
        {
          "@type": "Question",
          "name": "In the era of Meta DLRM, ASC, and Google PMax, why does 'Creative Is Targeting' (AL-CAT) outperform granular audience stacking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Deep learning recommendation models evaluate billions of real-time behavioral signals; manual interest stacking fragments liquidity and raises CPM. M4 runs Broad 1-CBO architectures using high-contrast native creative probes paired with whitelisted creator handles to bypass persuasion defenses and cut CPA by ~35%."
          }
        }
      ]
    : [
        {
          "@type": "Question",
          "name": "什么是 BrandOS™？它与传统出海营销（买量套利与代工铺货）有什么本质区别？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BrandOS™ 是专为中国出海企业打造的、从 0 到 1 科学构建全球高溢价品牌的工程化操作系统。传统出海营销依赖低价成本加成与平台买量套利，极易在获客成本上升时陷入亏损。BrandOS™ 将品牌建设拆解为 6 个因果咬合的工程模块（M1 勘测心智、M2 立住人设、M3 价值定价、M4 算法共振、M5 极速转化、M6 复利留存），引入 CBAP 商业分析、阶段门禁治理、昂贵信号理论与因果增量核算，让品牌建设像精密工程一样确定性复利。"
          }
        },
        {
          "@type": "Question",
          "name": "为什么 BrandOS™ 坚持将实收综合口袋毛利率（Blended Pocket Margin）红线锁死在 65%+？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "出海品牌若毛利率低于 65%，在面对 Meta/Google 等平台竞价成本通胀以及海外履约成本时将毫无抗风险能力。BrandOS™ 基于 BCG 三棱镜与前景理论，通过 M2 昂贵信号拉高用户支付意愿 (WTP)，运用 Good-Better-Best 3 档阶梯矩阵（主推款 Hero SKU 锁定 68%~72% 毛利，捕获 70% 销量），并严控价格瀑布漏损（≤15%），确保全店实收口袋毛利率严格 ≥65%，为研发创新与品牌复利提供坚不可摧的现金流燃料。"
          }
        },
        {
          "@type": "Question",
          "name": "什么是昂贵信号理论（Costly Signaling Theory）？出海新品牌如何破除海外消费者的防备心？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "昂贵信号理论源于诺贝尔经济学奖得主 Michael Spence。在信息不对称的市场中，口头吹嘘（Cheap Talk）对消费者毫无说服力。唯有假冒者一旦模仿就会破产的高成本、不可伪造硬核投入，才能实现分离均衡。BrandOS™ M2 模块要求品牌质押：① 物理工程质押；② 国际权威认证（如 UL 9540A、TÜV、SGS 报告）；③ 商业售后兜底（如 10 年免费换新）；④ 极限工况实测（如 -40℃ 破冰启动），并在独立站设立 Proof Center，彻底打破海外买家对中国新品牌的防备心。"
          }
        },
        {
          "@type": "Question",
          "name": "为什么广告后台面板的高 ROAS（如 4.0+）往往是虚假繁荣？什么是因果增量（Causal Incrementality / iROAS）？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "广告后台汇报的 ROAS 采用相关性归因，经常将本就会自然购买的老客与品牌词搜索用户算作广告功劳。BrandOS™ M6 模块引入 Donald Rubin 潜在因果推断模型，采用 Holdout Geo-Lift 区域停投对比实验测算真正的因果净增量：iROAS = (实验组实际销售额 - 反事实预测销售额) / 增量广告支出。若 iROAS < 1.0，即使后台 ROAS 达 4.0+ 也属于严重亏损。BrandOS™ 要求真实因果增量 iROAS ≥ 1.20，全店营销效率比 MER 达到 3.5~5.0。"
          }
        },
        {
          "@type": "Question",
          "name": "在现代 AI 推荐算法时代（Meta ASC / TikTok / Google PMax），为什么说‘素材即定向’（AL-CAT）优于人工受众细分？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "现代广告平台采用深度学习推荐模型（如 Meta DLRM），具备对数十亿用户的实时高维意图识别能力。人工叠加兴趣标签只会割裂拍卖池流动性。BrandOS™ M4 模块践行 AL-CAT 理论：70%~80% 预算采用 Broad 宽投 / 1-CBO 架构，把前 3 秒具备强认知冲突的 Lo-Fi 实拍素材作为高维探针让算法自动找人；同时通过创作者主页白标授权（Whitelisting）以红人身份投流，借熟人社交信用降低 35% CPA。"
          }
        }
      ]
};

const allEssays = (await getCollection('essays')).filter((e) => e.data.lang === lang);
allEssays.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const featuredEssay = allEssays.find((e) => e.data.featured) || allEssays[0];
const otherEssays = allEssays.filter((e) => e.id !== featuredEssay?.id).slice(0, 3);
const featuredHref = featuredEssay ? getLocalizedPath(`/essays/${getEssaySlug(featuredEssay)}`, lang) : getLocalizedPath('/essays', lang);
const essaysIndexHref = getLocalizedPath('/essays', lang);

const mailtoHref = isEn
  ? 'mailto:ranzhongus@icloud.com?subject=BrandOS%20Architecture%20Inquiry&body=Hi%20Ran%2C%20I%27m%20building%20a%20global%20DTC%20brand%20and%20would%20like%20to%20discuss%20implementing%20BrandOS.'
  : 'mailto:ranzhongus@icloud.com?subject=BrandOS%20%E5%93%81%E7%89%8C%E7%B3%BB%E7%BB%9F%E5%92%A8%E8%AF%A2&body=%E6%82%A8%E5%A5%BD%20Ran%EF%BC%8C%E6%88%91%E6%AD%A3%E5%9C%A8%E5%81%9A%E5%87%BA%E6%B5%B7%E4%B8%9A%E5%8A%A1%EF%BC%8C%E5%B8%8C%E6%9C%9B%E6%8E%A2%E8%AE%A8%E5%A6%82%E4%BD%95%E4%B8%BA%E6%88%91%E4%BB%AC%E7%9A%84%E4%BA%A7%E5%93%81%E6%90%AD%E5%BB%BA%20BrandOS%20%E5%93%81%E7%89%8C%E6%93%8D%E4%BD%9C%E7%B3%BB%E7%BB%9F%E3%80%82';
---

<Layout
  lang={lang}
  title={isEn
    ? 'BrandOS Lab™ | Engineering Global High-Margin DTC Brands'
    : '品牌科学实验室™ | BRANDOS LAB™ • 全球高溢价品牌操作系统'}
  description={isEn
    ? 'Ad spend resets to zero every day; mental equity compounds year after year. An engineering operating system for building high-margin global DTC brands from zero to one.'
    : '广告费是每天归零的消耗，而品牌心智是年年复利的资产。专为中国出海企业打造的、从 0 到 1 科学构建全球高溢价品牌的工程化操作系统。'}
  customSchema={homeCustomSchema}
>
  <!-- Background Grid -->
  <div class="fixed inset-0 pointer-events-none bg-lab-grid opacity-40 z-0"></div>

  <!-- SECTION 1: HERO MANIFESTO -->
  <section class="relative z-10 max-w-6xl mx-auto px-5 md:px-8 pt-20 sm:pt-28 pb-20 text-center flex flex-col items-center">
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 bg-[#111622]/90 border border-[#232B3E] rounded-full text-slate-200 font-mono text-[11px] uppercase tracking-[0.2em] mb-8 backdrop-blur-md shadow-inner">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#00F2FE]"></span>
      </span>
      <span class="font-extrabold text-slate-100">BRANDOS LAB™</span>
      <span class="text-slate-600">/</span>
      <span class="text-cyan-400 font-bold">BrandOS™ by Ran</span>
    </div>

    <h1 class="font-sans text-[30px] sm:text-[46px] md:text-[58px] text-slate-100 mb-8 tracking-[-0.03em] leading-[1.18] max-w-5xl">
      <span class="block text-slate-400 font-medium text-[21px] sm:text-[32px] md:text-[40px] mb-2 tracking-normal">
        {isEn ? 'A brand is not a trademark filing or a pretty logo —' : '品牌不是注册一个商标，更不是一个好看的 Logo ——'}
      </span>
      <span class="font-black text-slate-100">
        {isEn ? (
          <>
            It is the first name buyers recall when a problem strikes,<br class="hidden sm:inline" />
            <span class="relative inline-block mt-1">
              <span class="bg-gradient-to-r from-[#00F2FE] via-[#38BDF8] to-[#818CF8] bg-clip-text text-transparent font-black">
                and type straight into the search bar to buy.
              </span>
              <span class="inline-block w-2.5 sm:w-3.5 h-6 sm:h-10 bg-[#00F2FE] align-middle ml-1.5 animate-pulse rounded-xs"></span>
            </span>
          </>
        ) : (
          <>
            它是用户在最需要时，<br class="hidden sm:inline" />
            <span class="relative inline-block mt-1">
              <span class="bg-gradient-to-r from-[#00F2FE] via-[#38BDF8] to-[#818CF8] bg-clip-text text-transparent font-black">
                心里第一个跳出来、并在搜索框直接敲下的名字。
              </span>
              <span class="inline-block w-2.5 sm:w-3.5 h-6 sm:h-10 bg-[#00F2FE] align-middle ml-1.5 animate-pulse rounded-xs"></span>
            </span>
          </>
        )}
      </span>
    </h1>

    <div class="max-w-4xl w-full mb-12 bg-[#111622]/90 border border-[#232B3E] hover:border-cyan-500/40 p-6 sm:p-8 rounded-2xl backdrop-blur-md text-center shadow-[0_10px_30px_rgba(0,0,0,0.5)] transition-all duration-300 relative overflow-hidden group">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-32 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="font-mono text-rose-400 font-extrabold text-[14px] sm:text-[16px] tracking-wide mb-3 flex items-center justify-center gap-2 uppercase">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping inline-block"></span>
        <span>{isEn ? 'Zero ads, zero orders. Turn on ads, zero net margin —' : '不开广告 0 订单，开了广告 0 利润 ——'}</span>
      </div>

      <h2 class="text-[18px] sm:text-[24px] md:text-[29px] font-sans font-black text-slate-100 mb-4 tracking-tight leading-snug">
        {isEn ? (
          <>Why do Google, Meta, and Amazon keep charging emerging brands steeper <span class="text-rose-400 bg-rose-950/80 border border-rose-500/50 px-2 py-0.5 rounded mx-1 shadow-[0_0_20px_rgba(244,63,94,0.3)] inline-block">“traffic rent”</span>?</>
        ) : (
          <>为什么谷歌、亚马逊给中国跨境卖家收的<span class="text-rose-400 bg-rose-950/80 border border-rose-500/50 px-2 py-0.5 rounded mx-1 shadow-[0_0_20px_rgba(244,63,94,0.3)] inline-block">“保护费”</span>越来越多？</>
        )}
      </h2>

      <p class="text-slate-300 text-[15px] sm:text-[17px] font-normal leading-[1.8] max-w-3xl mx-auto border-t border-[#232B3E] pt-4 mt-2 font-sans">
        {isEn ? (
          <>
            Because you operate a supply chain that fulfills parcels—<strong class="text-slate-100 font-semibold underline decoration-rose-500/60 decoration-2 underline-offset-4">without brand memory</strong>;
            you rent short-term clicks—<strong class="text-cyan-400 font-bold bg-cyan-950/60 border border-cyan-500/40 px-2.5 py-0.5 rounded ml-1 inline-block mt-1 sm:mt-0 shadow-[0_0_15px_rgba(0,242,254,0.2)]">without a compounding brand operating system</strong>.
          </>
        ) : (
          <>
            因为你只有供应链在发货，<strong class="text-slate-100 font-semibold underline decoration-rose-500/60 decoration-2 underline-offset-4">没有自己的品牌</strong>；
            只有临时买流量，<strong class="text-cyan-400 font-bold bg-cyan-950/60 border border-cyan-500/40 px-2.5 py-0.5 rounded ml-1 inline-block mt-1 sm:mt-0 shadow-[0_0_15px_rgba(0,242,254,0.2)]">没有可以持续积累的属于自己的品牌系统</strong>。
          </>
        )}
      </p>
    </div>

    <!-- Dual Action CTAs -->
    <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 w-full justify-center">
      <a
        href="#brandos-pipeline"
        class="w-full sm:w-auto bg-slate-100 text-[#09090B] hover:bg-[#00F2FE] hover:shadow-[0_0_30px_rgba(0,242,254,0.4)] px-8 py-4 font-mono text-[13px] font-extrabold tracking-[0.15em] transition-all duration-200 uppercase rounded flex items-center justify-center gap-3 group"
      >
        <span>{isEn ? 'Inspect the 6-Step Architecture' : '查看 6 步品牌落地流程'}</span>
        <span class="group-hover:translate-y-0.5 transition-transform text-[16px]">↓</span>
      </a>
      <a
        href={essaysIndexHref}
        class="w-full sm:w-auto bg-[#111622]/80 hover:bg-[#182030] border border-[#232B3E] hover:border-cyan-400 text-slate-200 px-8 py-4 font-mono text-[13px] font-bold tracking-[0.15em] transition-all duration-200 uppercase rounded flex items-center justify-center gap-2 backdrop-blur"
      >
        <span>{isEn ? 'Read Brand Notes & Case Studies ↗' : '查阅品牌笔记与实例观察 ↗'}</span>
      </a>
    </div>
  </section>

  <!-- SECTION 2: THE ANTITHESIS -->
  <AntithesisMatrix lang={lang} />

  <!-- Anchor for #brandos-matrix -->
  <div id="brandos-matrix" class="scroll-mt-20"></div>

  <!-- SECTION 3: THE VERTICAL BRANDOS CAUSAL PIPELINE -->
  <BrandOSPipeline lang={lang} />

  <!-- SECTION 4: PEER-REVIEWED PROOF CENTER -->
  <section class="border-t border-[#232B3E] bg-[#0A0D14] py-24 sm:py-28 relative z-10">
    <div class="max-w-6xl mx-auto px-5 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="font-sans font-extrabold text-[30px] sm:text-[42px] text-slate-100">
          {isEn ? 'Unfakeable Empirical Foundations' : '不可伪造的跨学科实证网络'}
        </h2>
        <p class="text-slate-400 text-[15px] sm:text-[16px] mt-3 font-sans">
          {isEn
            ? 'BrandOS™ rejects marketing mysticism. Every module is grounded in Nobel-prize economics and peer-reviewed empirical science.'
            : 'BrandOS™ 拒绝营销玄学，每一个模块均深深扎根于经受住诺贝尔奖与严谨同行评议的实证理论。'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        <!-- Mentor 1: Michael Spence -->
        <div class="bg-[#111622] border border-[#232B3E] p-6 rounded-xl relative overflow-hidden flex flex-col justify-between">
          <div>
            <div class="font-mono text-[11px] text-indigo-400 uppercase tracking-widest mb-3 font-bold">NOBEL LAUREATE • 2001</div>
            <h3 class="font-sans text-[20px] font-bold text-slate-100 mb-2">
              {isEn ? 'Michael Spence' : 'Michael Spence (迈克尔·斯宾塞)'}
            </h3>
            <p class="text-slate-300 text-[14px] leading-relaxed mb-4 italic font-serif">
              {isEn
                ? '“In markets distorted by information asymmetry, cheap talk conveys zero proof. Discriminating buyers trust only costly signals that dishonest imitators cannot afford to mimic.”'
                : '“在信息严重不对称的全球市场中，廉价的言论毫无价值。唯有假冒者一旦模仿就会破产的高昂投入（Costly Signals），挑剔的买家才会真正产生确信。”'}
            </p>
            <div class="bg-[#09090B] border border-indigo-950 p-3 rounded-lg text-[12.5px] text-indigo-300 font-sans mb-4">
              <strong class="text-indigo-400 font-bold block mb-1">
                {isEn ? '🤔 Founder Dilemma Solved:' : '🤔 解决老板困惑：'}
              </strong>
              {isEn
                ? 'Why discounting + self-praise fails while competitors charge double and sell out.'
                : '为什么你降价自夸没人信，别人卖高价却被老外疯抢？'}
            </div>
          </div>
          <div class="font-mono text-[12px] text-slate-400 pt-3 border-t border-[#232B3E] mt-auto">
            {isEn ? 'Module Anchor: ' : '支撑模块：'}
            <strong class="text-indigo-400">{isEn ? 'M2 Unfakeable Trust (Costly Signaling)' : 'M2 信任质押 (昂贵信号理论与分离均衡机制)'}</strong>
          </div>
        </div>

        <!-- Mentor 2: Byron Sharp -->
        <div class="bg-[#111622] border border-[#232B3E] p-6 rounded-xl relative overflow-hidden flex flex-col justify-between">
          <div>
            <div class="font-mono text-[11px] text-cyan-400 uppercase tracking-widest mb-3 font-bold">EHRENBERG-BASS INSTITUTE</div>
            <h3 class="font-sans text-[20px] font-bold text-slate-100 mb-2">
              {isEn ? 'Byron Sharp' : 'Byron Sharp (拜伦·夏普)'}
            </h3>
            <p class="text-slate-300 text-[14px] leading-relaxed mb-4 italic font-serif">
              {isEn
                ? '“Consumers do not fall in love with founder slogans. Owning distinct Category Entry Points (CEPs) and removing retrieval friction is the empirical law of brand scale.”'
                : '“消费者不会爱上你的创业情怀。占领特定生活情境的品类进入点 (CEPs)，降低心智提取能耗，才是实现品牌规模化增长的唯一科学正道。”'}
            </p>
            <div class="bg-[#09090B] border border-cyan-950 p-3 rounded-lg text-[12.5px] text-cyan-300 font-sans mb-4">
              <strong class="text-cyan-400 font-bold block mb-1">
                {isEn ? '🤔 Founder Dilemma Solved:' : '🤔 解决老板困惑：'}
              </strong>
              {isEn
                ? 'Why chasing hyper-loyal superfans stalls growth while wide light-buyer reach wins.'
                : '为什么“私域狂热铁粉”是伪命题，占领痛点场景才是做大的正道？'}
            </div>
          </div>
          <div class="font-mono text-[12px] text-slate-400 pt-3 border-t border-[#232B3E] mt-auto">
            {isEn ? 'Module Anchor: ' : '支撑模块：'}
            <strong class="text-cyan-400">{isEn ? 'M1 Demand Radar (Mental Availability & CEPs)' : 'M1 勘测心智 (心智显著性与品类进入点网格)'}</strong>
          </div>
        </div>

        <!-- Mentor 3: Donald Rubin -->
        <div class="bg-[#111622] border border-[#232B3E] p-6 rounded-xl relative overflow-hidden flex flex-col justify-between">
          <div>
            <div class="font-mono text-[11px] text-emerald-400 uppercase tracking-widest mb-3 font-bold">HARVARD UNIVERSITY</div>
            <h3 class="font-sans text-[20px] font-bold text-slate-100 mb-2">
              {isEn ? 'Donald Rubin' : 'Donald Rubin (唐纳德·鲁宾)'}
            </h3>
            <p class="text-slate-300 text-[14px] leading-relaxed mb-4 italic font-serif">
              {isEn
                ? '“Orders that still happen when ads turn off are organic baseline; orders that vanish during regional holdouts reveal true incremental ROAS (iROAS).”'
                : '“停投广告后依然能自发完成的交易，属于老客自然回流；停投后立刻消失的订单，才代表广告创造的真实因果增量 (iROAS)。”'}
            </p>
            <div class="bg-[#09090B] border border-emerald-950 p-3 rounded-lg text-[12.5px] text-emerald-300 font-sans mb-4">
              <strong class="text-emerald-400 font-bold block mb-1">
                {isEn ? '🤔 Founder Dilemma Solved:' : '🤔 解决老板困惑：'}
              </strong>
              {isEn
                ? 'Why dashboards claiming 4.0x ROAS can hide cash burn until you run a holdout.'
                : '为什么后台 ROAS 4.0 依然亏损，停投实验才能算清真净利？'}
            </div>
          </div>
          <div class="font-mono text-[12px] text-slate-400 pt-3 border-t border-[#232B3E] mt-auto">
            {isEn ? 'Module Anchor: ' : '支撑模块：'}
            <strong class="text-emerald-400">{isEn ? 'M6 Retention (Causal Potential Outcomes)' : 'M6 复利留存 (潜在因果模型与反事实实验)'}</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: HIGH-IMPACT CALL TO ACTION -->
  <section class="max-w-6xl mx-auto px-5 md:px-8 py-20 sm:py-24 relative z-10">
    <div class="bg-gradient-to-b from-[#111622] to-[#0A0D14] border-2 border-cyan-500/50 rounded-3xl p-8 sm:p-14 text-center relative overflow-hidden shadow-[0_0_50px_rgba(0,242,254,0.12)]">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[500px] h-[200px] bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-cyan-950/80 border border-cyan-500/40 rounded-full font-mono text-[11px] font-bold text-cyan-400 uppercase tracking-[0.2em] mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        {isEn ? 'STRATEGIC EVOLUTION // BUILD YOUR BRAND ENGINE' : 'STRATEGIC EVOLUTION // 开启品牌之路'}
      </div>

      <h2 class="font-sans font-black text-[28px] sm:text-[40px] md:text-[46px] text-slate-100 mb-6 tracking-tight leading-[1.25] max-w-3xl mx-auto">
        {isEn ? (
          <>
            Stop bleeding margin inside commodity price wars—<br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-[#00F2FE] via-[#38BDF8] to-[#818CF8] bg-clip-text text-transparent">
              start engineering your brand equity today.
            </span>
          </>
        ) : (
          <>
            与其在价格战里继续内卷，<br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-[#00F2FE] via-[#38BDF8] to-[#818CF8] bg-clip-text text-transparent">
              不如从今天开启你的品牌之路。
            </span>
          </>
        )}
      </h2>

      <p class="font-sans text-slate-300 text-[15px] sm:text-[17px] max-w-2xl mx-auto leading-relaxed mb-10">
        {isEn
          ? 'Leave daily ad-spend anxiety behind. Install BrandOS™ to convert manufacturing precision into uncopiable pricing power and direct global demand.'
          : '告别每天归零的买量焦虑。装载 BrandOS™ 操作系统，把中国制造的供应链实力，转化为海外用户指名购买的确定性高溢价。'}
      </p>

      <div class="flex justify-center">
        <a
          href={mailtoHref}
          class="inline-flex items-center gap-3 bg-slate-100 hover:bg-[#00F2FE] text-[#09090B] px-8 sm:px-10 py-4 sm:py-4.5 rounded-xl font-mono text-[14px] sm:text-[15px] font-extrabold uppercase tracking-wider transition-all duration-300 hover:shadow-[0_0_35px_rgba(0,242,254,0.45)] hover:scale-[1.02] group"
        >
          <svg class="w-4 h-4 text-[#09090B]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <span>{isEn ? 'Consult Founder' : '马上咨询'}</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 6: BRAND NOTES -->
  <section class="max-w-6xl mx-auto px-5 md:px-8 py-24 sm:py-28 relative z-10 border-t border-[#232B3E]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 border-b border-[#232B3E] pb-6 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-0.5 bg-cyan-950/60 border border-cyan-800/60 rounded-full font-mono text-[11px] font-bold text-cyan-400 uppercase tracking-[0.2em] mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
          {isEn ? 'CONTINUOUS RESEARCH // BRAND NOTES & CASE STUDIES' : 'CONTINUOUS RESEARCH // 品牌笔记与实例观察'}
        </div>
        <h2 class="font-sans font-extrabold text-[28px] sm:text-[40px] text-slate-100 leading-tight">
          {isEn ? 'Brand Notes & Case Studies' : '品牌笔记与实例观察'}
        </h2>
      </div>
      <a href={essaysIndexHref} class="text-slate-200 hover:text-cyan-400 font-mono text-[13px] font-bold uppercase tracking-wider flex items-center gap-1.5 transition-colors self-start sm:self-auto">
        <span>{isEn ? `All Brand Notes (${allEssays.length})` : `全部品牌笔记 (${allEssays.length} 篇)`}</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-8 items-stretch">
      {featuredEssay && (
        <article class="bg-[#111622] border border-cyan-500/50 hover:border-cyan-400 rounded-2xl p-6 sm:p-10 flex flex-col md:flex-row gap-8 justify-between transition-all duration-300 group hover:shadow-[0_0_40px_rgba(0,242,254,0.1)] relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-cyan-400 text-[#09090B] font-mono text-[9px] font-black px-3 py-1 uppercase tracking-widest">
            FEATURED OBSERVATION
          </div>

          <a
            href={featuredHref}
            class="w-full md:w-5/12 aspect-[16/10] rounded-xl overflow-hidden border border-[#232B3E] bg-[#09090B] relative group-hover:border-cyan-500/40 transition-colors flex-shrink-0 block"
          >
            <img
              src={featuredEssay.data.coverImage || (isEn ? '/images/essays/cover-zero-to-one-brand-framework-en.svg' : '/images/essays/cover-zero-to-one-brand-framework.svg')}
              alt={featuredEssay.data.coverAlt || featuredEssay.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#111622] via-transparent to-transparent opacity-30 pointer-events-none"></div>
          </a>

          <div class="flex flex-col justify-between flex-grow">
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-4">
                <span class="font-mono text-[11px] font-extrabold uppercase tracking-wider text-cyan-400 bg-cyan-950/60 border border-cyan-800/60 px-3 py-0.5 rounded">
                  {featuredEssay.data.module} • {featuredEssay.data.moduleName}
                </span>
                <span class="font-mono text-[11px] text-slate-400">
                  ⏱ {featuredEssay.data.readingTime}
                </span>
                <span class="font-mono text-[11px] text-slate-500">
                  • {isEn ? 'Author: ' : '作者：'}{featuredEssay.data.author || (isEn ? 'Ran' : 'Ran (然)')}
                </span>
              </div>

              <h3 class="font-sans font-bold text-[22px] sm:text-[28px] text-slate-100 mb-3 group-hover:text-cyan-400 transition-colors leading-snug">
                <a href={featuredHref}>
                  {featuredEssay.data.title}
                </a>
              </h3>

              <p class="font-sans text-[14.5px] sm:text-[15.5px] text-slate-300 leading-relaxed mb-6">
                {featuredEssay.data.description}
              </p>
            </div>

            <a
              href={featuredHref}
              class="pt-4 border-t border-[#232B3E] flex items-center justify-between font-mono text-[13px] font-bold text-slate-100 group-hover:text-cyan-400 transition-colors mt-auto"
            >
              <span>{isEn ? 'Read Full Case Note' : '阅读完整实例观察'}</span>
              <span class="group-hover:translate-x-2 transition-transform text-[16px]">→</span>
            </a>
          </div>
        </article>
      )}
    </div>

    {otherEssays.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mt-8">
        {otherEssays.map((essay) => (
          <EssayCard essay={essay} lang={lang} />
        ))}
      </div>
    )}
  </section>
</Layout>