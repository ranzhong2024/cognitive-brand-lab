      <!-- Modal Header -->
      <div class="flex items-center justify-between p-4 sm:p-5 border-b border-[#232B3E] bg-[#09090B]">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
