---
import Layout from '../layouts/Layout.astro';

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": "https://ranbrandos.com/about#profile",
      "name": "关于实验室与发起人 | 品牌科学实验室™ • BRANDOS LAB™",
      "url": "https://ranbrandos.com/about",
      "mainEntity": {
        "@type": "Person",
        "@id": "https://ranbrandos.com/#founder",
        "name": "Ran (然)",
        "jobTitle": "Principal BrandOS Architect & Founder",
        "url": "https://ranbrandos.com/about",
        "description": "品牌科学实验室™ 发起人兼首席架构师。北美数字营销硕士，IIBA CBAP 国际注册商业分析师，谷歌数据分析与数字营销认证操盘手。",
        "sameAs": [
          "https://www.credly.com/badges/8c8d8b9e-648b-4b2a-89aa-5527ba5139fb/linked_in_profile",
          "https://www.credly.com/badges/0c72eefb-5343-4636-8a10-75aa12aa5cba/linked_in_profile"
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://ranbrandos.com/about#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首页",
          "item": "https://ranbrandos.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "关于实验室与发起人",
          "item": "https://ranbrandos.com/about"
        }
      ]
    }
  ]
};
---

<Layout 
  title="关于实验室与发起人 | 品牌科学实验室™ • BRANDOS LAB™"
  description="关于品牌科学实验室™（BRANDOS LAB™）与发起人 Ran。融合商业分析（CBAP）、行为经济学、因果统计与认知心理学，为中国跨境出海构建不可动摇的品牌操作系统。"
  currentPath="/about"
  customSchema={aboutSchema}
>
  <div class="max-w-6xl mx-auto w-full px-5 md:px-8 py-16 sm:py-24 flex flex-col gap-20 sm:gap-28">
    
    <!-- SECTION 1: HERO MANIFESTO (实验室宣言与思想缘起) -->
    <section class="relative">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-cyan-950/60 border border-cyan-800/60 rounded-full font-mono text-[11px] font-bold text-cyan-400 uppercase tracking-[0.2em] mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        BRANDOS LAB™ // LABORATORY MANIFESTO
      </div>

      <h1 class="font-sans font-black text-[32px] sm:text-[48px] md:text-[56px] text-slate-100 tracking-tight leading-[1.15] max-w-4xl mb-8">
        用理科生的大脑，<br />
        <span class="bg-gradient-to-r from-[#00F2FE] via-[#38BDF8] to-[#818CF8] bg-clip-text text-transparent">
          重构中国出海的品牌操作系统。
        </span>
      </h1>

      <p class="font-sans text-[17px] sm:text-[20px] text-slate-300 max-w-3xl leading-[1.8] font-normal">
        我们探究品牌在人类心智中的认知结构与因果机制。<br class="hidden sm:inline" />
        将商业分析（CBAP）、行为心理学与因果数据科学工程化，彻底终结跨境出海的玄学内卷与买量绞杀。
      </p>
    </section>

    <!-- SECTION 2: FOUNDER DOSSIER (发起人与首席架构师档案) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch border-t border-[#232B3E] pt-16">
      <!-- Left: Founder Card & Core Credentials -->
      <div class="lg:col-span-5 bg-[#111622] border border-[#232B3E] p-7 sm:p-8 rounded-2xl flex flex-col justify-between relative overflow-hidden shadow-2xl">
        <div class="absolute top-0 right-0 bg-cyan-400 text-[#09090B] font-mono text-[10px] font-black px-3 py-1 uppercase tracking-widest">
          LEAD ARCHITECT
        </div>

        <div>
          <!-- Avatar / Mark Lockup -->
          <div class="w-20 h-20 rounded-2xl bg-[#09090B] border-2 border-cyan-500/50 flex items-center justify-center mb-6 shadow-[0_0_25px_rgba(0,242,254,0.15)]">
            <svg class="w-10 h-10 text-cyan-400" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 16 H56 C68 16 76 24 76 36 C76 45 70 51 61 53 C73 55 80 63 80 73 C80 86 70 94 56 94 H24 Z" fill="currentColor" fill-rule="evenodd"/>
            </svg>
          </div>

          <h2 class="font-sans text-[26px] sm:text-[28px] font-black text-slate-100 mb-1">
            Ran (然)
          </h2>
          <div class="font-mono text-[12px] text-cyan-400 font-bold uppercase tracking-wider mb-6">
            FOUNDER & PRINCIPAL INVESTIGATOR // 品牌科学实验室™
          </div>

          <!-- Credential Tags (4 Pillars: MS, CBAP, Google Certs) -->
          <div class="space-y-3 mb-8">
            <!-- 1. 北美数字营销硕士 -->
            <div class="flex items-center justify-between bg-[#09090B] p-3.5 rounded-xl border border-[#232B3E] hover:border-cyan-500/40 transition-colors group">
              <div class="flex items-center gap-3">
                <span class="text-cyan-400 font-mono font-bold text-[14px]">🎓</span>
                <div>
                  <div class="font-sans font-bold text-[14px] text-slate-100">北美数字营销硕士</div>
                  <div class="font-sans text-[12px] text-slate-400">为多个北美知名品牌做咨询</div>
                </div>
              </div>
              <span class="font-mono text-[10px] text-slate-500 uppercase font-semibold">MASTER OF SCIENCE</span>
            </div>

            <!-- 2. CBAP (Interactive Certificate Modal Trigger) -->
            <button 
              type="button"
              id="open-cbap-modal"
              class="w-full flex items-center justify-between bg-[#09090B] hover:bg-indigo-950/30 p-3.5 rounded-xl border border-[#232B3E] hover:border-indigo-400/80 transition-all text-left group cursor-pointer shadow-sm"
            >
              <div class="flex items-center gap-3">
                <span class="text-indigo-400 font-mono font-bold text-[14px]">📐</span>
                <div>
                  <div class="font-sans font-bold text-[14px] text-slate-100 group-hover:text-indigo-300 transition-colors">
                    CBAP
                  </div>
                  <div class="font-sans text-[12px] text-slate-400">IIBA 国际注册商业分析师 (Certified Business Analysis Professional)</div>
                </div>
              </div>
              <span class="text-indigo-400 font-mono text-[14px] group-hover:translate-x-1 transition-transform">↗</span>
            </button>

            <!-- 3. 谷歌数字营销师 (Credly Link) -->
            <a 
              href="https://www.credly.com/badges/0c72eefb-5343-4636-8a10-75aa12aa5cba/linked_in_profile" 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center justify-between bg-[#09090B] hover:bg-amber-950/30 p-3.5 rounded-xl border border-[#232B3E] hover:border-amber-400/80 transition-all group shadow-sm"
            >
              <div class="flex items-center gap-3">
                <span class="text-amber-400 font-mono font-bold text-[14px]">📈</span>
                <div>
                  <div class="font-sans font-bold text-[14px] text-slate-100 group-hover:text-amber-300 transition-colors">
                    谷歌数字营销师
                  </div>
                  <div class="font-sans text-[12px] text-slate-400">Google Digital Marketing & E-Commerce Professional</div>
                </div>
              </div>
              <span class="text-amber-400 font-mono text-[14px] group-hover:translate-x-1 transition-transform">↗</span>
            </a>

            <!-- 4. 谷歌数据分析师 (Credly Link) -->
            <a 
              href="https://www.credly.com/badges/ed02588e-fae3-4fec-93f5-177251e7725e/linked_in_profile" 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center justify-between bg-[#09090B] hover:bg-emerald-950/30 p-3.5 rounded-xl border border-[#232B3E] hover:border-emerald-400/80 transition-all group shadow-sm"
            >
              <div class="flex items-center gap-3">
                <span class="text-emerald-400 font-mono font-bold text-[14px]">📊</span>
                <div>
                  <div class="font-sans font-bold text-[14px] text-slate-100 group-hover:text-emerald-300 transition-colors">
                    谷歌数据分析师
                  </div>
                  <div class="font-sans text-[12px] text-slate-400">Google Data Analytics Professional Certificate</div>
                </div>
              </div>
              <span class="text-emerald-400 font-mono text-[14px] group-hover:translate-x-1 transition-transform">↗</span>
            </a>
          </div>
        </div>

        <div class="pt-4 border-t border-[#232B3E] font-mono text-[11px] text-slate-500">
          LOCATION: UNITED STATES & GLOBAL DTC ECOSYSTEM
        </div>
      </div>

      <!-- Right: Narrative Manifesto & The 10-Year Trench Insight -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        <div class="bg-[#111622] border border-[#232B3E] p-7 sm:p-9 rounded-2xl">
          <div class="font-mono text-[11px] text-slate-400 uppercase tracking-wider mb-4 font-bold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            <span>来自出海战壕 10 年的一线省思</span>
          </div>

          <h3 class="font-sans text-[22px] sm:text-[24px] font-bold text-slate-100 mb-5 leading-snug">
            “我不是空谈理论的学者，也不是兜售流量焦虑的代运营中介。”
          </h3>

          <div class="space-y-4 font-sans text-slate-300 text-[15px] sm:text-[16px] leading-[1.8]">
            <p>
              我是一名在出海一线战壕里摸爬滚打 10 余年、操盘过数千万级海外投放预算的实战家。
            </p>
            <p>
              在这 10 年里，我亲眼见证了无数优秀的中国工厂、研发团队与跨境卖家，在毫无定价权的低价红海中流尽最后一滴血。辛苦一年把货发到全世界，到年底一算账，大半利润全当作“保护费”交给了海外广告平台。
            </p>
            <p>
              许多人把失败归咎于“不懂海外营销”或“没做好设计”，但真正的病根在于<strong>认知与系统的割裂</strong> —— 懂供应链的不懂海外买家心智，懂买量投放的算不清因果增量，做视觉创意的做不出商业闭环。
            </p>
            <p class="text-slate-100 font-semibold bg-[#09090B] p-4 rounded-xl border border-[#232B3E]">
              💡 我们的核心信念：<br />
              <span class="text-cyan-400 font-normal">
                广告费是每天归零的消耗，而品牌心智是年年复利的资产。品牌不是注册一个商标或画一个好看的 Logo，而是让海外挑剔买家在搜索框主动敲下你的名字。
              </span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: 3 INVIOLABLE IRON LAWS (实验室三大铁律) -->
    <section class="border-t border-[#232B3E] pt-16">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="font-mono text-[11px] font-bold text-cyan-400 uppercase tracking-[0.2em] block mb-2">
          LABORATORY GUARDRAILS
        </span>
        <h2 class="font-sans font-extrabold text-[28px] sm:text-[38px] text-slate-100">
          实验室三大铁律
        </h2>
        <p class="font-sans text-slate-400 text-[15px] sm:text-[16px] mt-2">
          每一份交付、每一篇专著、每一个策略，必须经受住严格的科学与商业检验。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        <!-- Law 1 -->
        <div class="bg-[#111622] border border-[#232B3E] p-7 rounded-xl flex flex-col justify-between hover:border-cyan-500/50 transition-all group">
          <div>
            <div class="font-mono text-[24px] font-black text-cyan-400 mb-4 group-hover:scale-110 transition-transform origin-left">
              01
            </div>
            <h3 class="font-sans text-[19px] font-bold text-slate-100 mb-3">
              科学实证优先<br />
              <span class="text-slate-400 text-[14px] font-normal font-mono">SCIENCE OVER MYTH</span>
            </h3>
            <p class="font-sans text-slate-300 text-[14px] leading-relaxed">
              不谈玄学，不灌鸡汤。基于全球顶流同行评议学派（Ehrenberg-Bass、诺奖 Spence、哈佛 Rubin 因果统计），系统性击碎出海圈的买量谬误与虚假高 ROAS 幻觉。
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-[#232B3E] font-mono text-[11px] text-cyan-400 font-bold uppercase">
            ✓ 严谨同行评议背书
          </div>
        </div>

        <!-- Law 2 -->
        <div class="bg-[#111622] border border-[#232B3E] p-7 rounded-xl flex flex-col justify-between hover:border-indigo-500/50 transition-all group">
          <div>
            <div class="font-mono text-[24px] font-black text-indigo-400 mb-4 group-hover:scale-110 transition-transform origin-left">
              02
            </div>
            <h3 class="font-sans text-[19px] font-bold text-slate-100 mb-3">
              系统工程胜于碎片战术<br />
              <span class="text-slate-400 text-[14px] font-normal font-mono">SYSTEM OVER TACTICS</span>
            </h3>
            <p class="font-sans text-slate-300 text-[14px] leading-relaxed">
              用完整的 BrandOS™ 6 阶段操作系统取代零散的改图、测品或投流小技巧。从心智勘测、战略定价到复利留存，为企业建立可度量、可复利的长期护城河。
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-[#232B3E] font-mono text-[11px] text-indigo-400 font-bold uppercase">
            ✓ 6 阶段全景闭环交付
          </div>
        </div>

        <!-- Law 3 -->
        <div class="bg-[#111622] border border-[#232B3E] p-7 rounded-xl flex flex-col justify-between hover:border-emerald-500/50 transition-all group">
          <div>
            <div class="font-mono text-[24px] font-black text-emerald-400 mb-4 group-hover:scale-110 transition-transform origin-left">
              03
            </div>
            <h3 class="font-sans text-[19px] font-bold text-slate-100 mb-3">
              商业分析与心智因果闭环<br />
              <span class="text-slate-400 text-[14px] font-normal font-mono">MULTI-DISCIPLINARY RIGOR</span>
            </h3>
            <p class="font-sans text-slate-300 text-[14px] leading-relaxed">
              打破传统“做营销的不懂商业财务、做数据的不懂用户心智”的壁垒。以理科生的严谨建模 + 一线操盘手的敏锐触觉，输出高认知密度的商业智库。
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-[#232B3E] font-mono text-[11px] text-emerald-400 font-bold uppercase">
            ✓ 跨学科降维解构
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: EVOLUTION TIMELINE (方法论演进历程) -->
    <section class="border-t border-[#232B3E] pt-16">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="font-mono text-[11px] font-bold text-cyan-400 uppercase tracking-[0.2em] block mb-2">
          METHODOLOGY EVOLUTION
        </span>
        <h2 class="font-sans font-extrabold text-[28px] sm:text-[38px] text-slate-100">
          BrandOS™ 演进历程
        </h2>
      </div>

      <div class="max-w-3xl mx-auto space-y-6">
        <!-- Milestone 1 -->
        <div class="bg-[#111622] border border-[#232B3E] p-6 sm:p-7 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="font-mono text-[12px] text-rose-400 font-bold mb-1">2016 – 2020</div>
            <h3 class="font-sans text-[18px] font-bold text-slate-100 mb-1">战壕实操与百亿买量困局</h3>
            <p class="font-sans text-[14px] text-slate-400">
              深度操盘跨国电商与出海独立站，亲历买量模式的脆弱与恶性杀价，萌生用系统论重构品牌心智的构想。
            </p>
          </div>
          <span class="font-mono text-[11px] text-slate-500 bg-[#09090B] px-3 py-1.5 rounded border border-[#232B3E] shrink-0 self-start sm:self-auto">
            PHASE 01: 痛点觉醒
          </span>
        </div>

        <!-- Milestone 2 -->
        <div class="bg-[#111622] border border-[#232B3E] p-6 sm:p-7 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="font-mono text-[12px] text-indigo-400 font-bold mb-1">2021 – 2023</div>
            <h3 class="font-sans text-[18px] font-bold text-slate-100 mb-1">跨学科知识谱系融合</h3>
            <p class="font-sans text-[14px] text-slate-400">
              北美数字营销深造与实战咨询，系统打通 CBAP 商业分析架构、行为经济学、因果数据统计与 BCG 定价科学体系。
            </p>
          </div>
          <span class="font-mono text-[11px] text-slate-500 bg-[#09090B] px-3 py-1.5 rounded border border-[#232B3E] shrink-0 self-start sm:self-auto">
            PHASE 02: 体系熔铸
          </span>
        </div>

        <!-- Milestone 3 -->
        <div class="bg-[#111622] border-2 border-cyan-500/60 p-6 sm:p-7 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-[0_0_30px_rgba(0,242,254,0.08)]">
          <div>
            <div class="font-mono text-[12px] text-cyan-400 font-bold mb-1">2024 – 2026</div>
            <h3 class="font-sans text-[18px] font-bold text-slate-100 mb-1">BrandOS™ 操作系统发布</h3>
            <p class="font-sans text-[14px] text-slate-400">
              创立品牌科学实验室™（BRANDOS LAB™），将 6 大核心工程模块公开化输出，为中国跨境出海提供权威科学智库。
            </p>
          </div>
          <span class="font-mono text-[11px] text-[#09090B] bg-cyan-400 font-black px-3 py-1.5 rounded shrink-0 self-start sm:self-auto uppercase">
            PHASE 03: 全面发布
          </span>
        </div>
      </div>
    </section>

    <!-- SECTION 5: HIGH-IMPACT CALL TO ACTION (战略跃迁与直联 Ran) -->
    <section class="border-t border-[#232B3E] pt-16">
      <div class="bg-gradient-to-b from-[#111622] to-[#0A0D14] border-2 border-cyan-500/50 rounded-3xl p-8 sm:p-14 text-center relative overflow-hidden shadow-[0_0_50px_rgba(0,242,254,0.12)]">
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[500px] h-[200px] bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-cyan-950/80 border border-cyan-500/40 rounded-full font-mono text-[11px] font-bold text-cyan-400 uppercase tracking-[0.2em] mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
          DIRECT COMMUNICATION // 与发起人建立深度连接
        </div>

        <h2 class="font-sans font-black text-[28px] sm:text-[38px] md:text-[44px] text-slate-100 mb-6 tracking-tight leading-[1.25] max-w-3xl mx-auto">
          与其在价格战里继续内卷，<br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-[#00F2FE] via-[#38BDF8] to-[#818CF8] bg-clip-text text-transparent">
            不如从今天开启你的品牌之路。
          </span>
        </h2>

        <p class="font-sans text-slate-300 text-[15px] sm:text-[17px] max-w-2xl mx-auto leading-relaxed mb-10">
          深度出海品牌战略探讨、商业分析咨询与学术交流，欢迎直接来信。
        </p>

        <div class="flex justify-center">
          <a 
            href="mailto:ranzhongus@icloud.com?subject=BrandOS%20%E5%93%81%E7%89%8C%E7%B3%BB%E7%BB%9F%E5%92%A8%E8%AF%A2&body=%E6%82%A8%E5%A5%BD%20Ran%EF%BC%8C%E6%88%91%E6%AD%A3%E5%9C%A8%E5%81%9A%E5%87%BA%E6%B5%B7%E4%B8%9A%E5%8A%A1%EF%BC%8C%E5%B8%8C%E6%9C%9B%E6%8E%A2%E8%AE%A8%E5%A6%82%E4%BD%95%E4%B8%BA%E6%88%91%E4%BB%AC%E7%9A%84%E4%BA%A7%E5%93%81%E6%90%AD%E5%BB%BA%20BrandOS%20%E5%93%81%E7%89%8C%E6%93%8D%E4%BD%9C%E7%B3%BB%E7%BB%9F%E3%80%82"
