---
import Layout from '../../layouts/Layout.astro';
import ModuleSectionCard from '../../components/ModuleSectionCard.astro';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'm1-brand-foundations' },
      props: {
        id: 'M1',
        title: 'M1 勘测心智：锁定真实生活场景与心智入口 (Demand Radar & Mental Sensing)',
        description: '怎么让海外用户在产生需求的一瞬间，第一个想起你？基于 Byron Sharp CEPs 场景网格与 Clayton Christensen JTBD 任务雇佣理论。',
        systemContext: 'Layer 01 • 基础层 (Foundation Layer)',
        nextModule: { slug: 'm2-behavioral-science', name: 'M2: 立住人设与信用质押' },
        prevModule: null,
        sections: [
          { number: '01', title: 'Byron Sharp CEPs 场景网格构建', desc: '5W1H 购买触发情境扫描，构建多维度心智检索通路与物理可得性。' },
          { number: '02', title: 'Clayton Christensen JTBD 进展力学', desc: '推进力、拉动力、焦虑阻力与习惯惯性的四力平衡分析。' },
          { number: '03', title: 'AEO 机器语义与主题簇确权', desc: '在 ChatGPT / Perplexity / Google SGE 知识图谱中建立第一信源索引。' },
        ],
      },
    },
    {
      params: { slug: 'm2-behavioral-science' },
      props: {
        id: 'M2',
        title: 'M2 立住人设：打造不可伪造的硬核信任与品牌指纹 (Unfakeable Trust & DBAs)',
        description: '破译海外高净值买家的信任神经，用 Michael Spence 昂贵信号与 Byron Sharp 独特品牌资产构建信任护城河。',
        systemContext: 'Layer 01 • 基础层 (Foundation Layer)',
        nextModule: { slug: 'm3-strategic-pricing', name: 'M3: 价值定价与毛利工程' },
        prevModule: { slug: 'm1-brand-foundations', name: 'M1: 勘测心智与需求雷达' },
        sections: [
          { number: '01', title: 'Michael Spence 昂贵信号单次穿越', desc: '为什么口头宣传是零价值的？如何用高成本不可伪造投入实现分离均衡。' },
          { number: '02', title: 'Byron Sharp DBA 独特品牌资产网格', desc: '专属构型轮廓、色彩编码与声纹指纹的心智检索垄断。' },
          { number: '03', title: 'Rory Sutherland 仰巴脚效应 (Pratfall Effect)', desc: '主动暴露适用边界与劝退非目标客群，反向倍增核心承诺的可信度。' },
        ],
      },
    },
    {
      params: { slug: 'm3-strategic-pricing' },
      props: {
        id: 'M3',
        title: 'M3 价值定价：依据心理账户与 WTP 锁死 65%+ 战略毛利 (Strategic Value Pricing)',
        description: '怎么把商品卖得比对手贵 30%，还能捕获全部利润？拒绝亏本赚吆喝的恶性价格战。',
        systemContext: 'Layer 02 • 战略层 (Strategy Layer)',
        nextModule: { slug: 'm4-algorithmic-resonance', name: 'M4: 算法共振与创作者套利' },
        prevModule: { slug: 'm2-behavioral-science', name: 'M2: 立住人设与信用质押' },
        sections: [
          { number: '01', title: 'Hermann Simon 定价微积分与利润杠杆', desc: '1% 价格改善带来 11.1% 营业利润增长的微观机制。' },
          { number: '02', title: 'McKinsey 价格瀑布漏损审计', desc: '堵住渠道佣金、运费逆向折损与 PPC 广告补贴黑洞。' },
          { number: '03', title: 'Good-Better-Best 3 档阶梯利润沙盘', desc: '通过阶梯产品矩阵提取消费者剩余，主推款毛利锁定在 65%+。' },
        ],
      },
    },
    {
      params: { slug: 'm4-algorithmic-resonance' },
      props: {
        id: 'M4',
        title: 'M4 算法共振：素材即定向探针与创作者信誉套利 (Algorithmic Resonance)',
        description: '为什么人工受众细分正在杀死利润？深度解构 Meta DLRM 算法拍卖动力学、说服知识模型 (PKM) 与红人白标授权。',
        systemContext: 'Layer 03 • 规模层 (Scale Layer)',
        nextModule: { slug: 'm5-conversion-engineering', name: 'M5: 极速转化与主权基建' },
        prevModule: { slug: 'm3-strategic-pricing', name: 'M3: 价值定价与毛利工程' },
        sections: [
          { number: '01', title: 'Meta DLRM 现代推荐拍卖与 AL-CAT', desc: '素材即定向：用高维语义探针让千亿参数算法自动找人。' },
          { number: '02', title: '说服知识模型 (PKM) 与准社会关系 (PSI)', desc: '为什么官方账号自夸被秒划走？借创作者信任资产击碎用户防御。' },
          { number: '03', title: 'Broad 1-CBO 极简账户与 3 秒 Hook 模式库', desc: '认知冲突、极限酷刑测试与前后对比模式，实现 CPA 规模化降低。' },
        ],
      },
    },
    {
      params: { slug: 'm5-conversion-engineering' },
      props: {
        id: 'M5',
        title: 'M5 极速转化：极速转化科学与 100px 近地证据链 (Rapid Conversion Science)',
        description: '让人脑 3 秒秒懂，让 AI 问答引擎主动首推。基于 MECLABS 启发式方程、System 1 直觉流畅性与 Core Web Vitals。',
        systemContext: 'Layer 03 • 转化层 (Conversion Layer)',
        nextModule: { slug: 'm6-compounding-retention', name: 'M6: 复利留存与因果度量' },
        prevModule: { slug: 'm4-algorithmic-resonance', name: 'M4: 算法共振与创作者套利' },
        sections: [
          { number: '01', title: 'MECLABS 转化启发式方程深度拆解', desc: '动机 4m + 价值 3v + 激励 2(i-f) - 焦虑 2a 的全链路落地。' },
          { number: '02', title: '100px 近地证据链与 3 秒首屏黄金三角', desc: '在结账 CTA 上下 100 像素内密织质保、时效、退换与安全支付防伪网。' },
          { number: '03', title: 'Google Core Web Vitals 物理性能底线', desc: 'LCP < 1.0s, INP < 100ms, CLS = 0 与 Schema.org JSON-LD 结构化数据。' },
        ],
      },
    },
    {
      params: { slug: 'm6-compounding-retention' },
      props: {
        id: 'M6',
        title: 'M6 复利留存：复利留存与因果增量度量 (Compounding Retention & Causal Lab)',
        description: '自适应行为流做管家，因果实验算清真利润。基于 Reforge 留存微笑曲线、沃顿商学院 BG/NBD 客户模型与 Rubin 因果推断。',
        systemContext: 'Layer 04 • 复利层 (Compounding Layer)',
        nextModule: null,
        prevModule: { slug: 'm5-conversion-engineering', name: 'M5: 极速转化与主权基建' },
        sections: [
          { number: '01', title: 'Donald Rubin 潜在因果推断与 Geo-Lift Holdout', desc: '通过停投实验剔除自然截流假归因，测算真实的 iROAS 净现金流。' },
          { number: '02', title: '沃顿商学院 Peter Fader BG/NBD 概率模型', desc: '后验存活概率 P(Alive) 精准分层与自适应生命周期动作。' },
          { number: '03', title: '6 大核心自适应流与发信域名物理信誉', desc: 'Flow-First 架构贡献 50%~70% CRM 利润，严格遵循 SPF/DKIM/DMARC 治理。' },
        ],
      },
    },
  ];
}

const { id, title, description, systemContext, nextModule, prevModule, sections } = Astro.props;
const allEssays = await getCollection('essays');
const essays = allEssays.filter((e) => e.data.module === id);
---

<Layout title={`${title} | 品牌科学实验室 (BRANDOS LAB)`} description={description}>
  <div class="max-w-6xl mx-auto px-6 py-20">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 font-mono text-xs text-slate-500 uppercase tracking-widest mb-8">
      <a href="/" class="hover:text-cyan-400 transition-colors">BRANDOS LAB</a>
      <span>/</span>
      <a href="/#brandos-matrix" class="hover:text-cyan-400 transition-colors">ENGINE</a>
      <span>/</span>
      <span class="text-cyan-400">{id}</span>
    </div>

    <!-- Header Block -->
    <div class="border-b border-slate-800 pb-10 mb-12">
      <div class="inline-block font-mono text-xs font-bold text-cyan-400 bg-cyan-950/40 border border-cyan-800/40 px-2.5 py-1 rounded mb-4">
        {systemContext}
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-slate-100 mb-4 leading-tight">
        {title}
      </h1>
      <p class="font-sans text-slate-400 text-base max-w-3xl leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Key Sections Grid -->
    <div class="mb-16">
      <h2 class="font-mono text-xs font-bold text-slate-400 uppercase tracking-[0.2em] mb-6">
        模块工程支柱 (ENGINEERING PILLARS)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {sections.map((sec) => (
          <ModuleSectionCard number={sec.number} title={sec.title} desc={sec.desc} />
        ))}
      </div>
    </div>

    <!-- Related Flagship Essays -->
    <div class="mb-16 border-t border-slate-800 pt-12">
      <div class="flex justify-between items-end mb-8">
        <div>
          <h2 class="font-mono text-xs font-bold text-cyan-400 uppercase tracking-[0.2em] mb-1">
            模块相关研报专著
          </h2>
          <p class="font-serif text-2xl text-slate-100">
            {id} 深度理论与实战案例单行本
          </p>
        </div>
      </div>

      {essays.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {essays.map((essay) => {
            const targetId = essay.id || essay.slug;
            return (
              <div class="bg-slate-900 border border-slate-800 hover:border-cyan-500/50 p-6 rounded-lg flex flex-col justify-between group">
                <div>
                  <div class="flex justify-between items-center mb-2 font-mono text-xs text-slate-500">
                    <span class="text-cyan-400 font-bold uppercase">{essay.data.moduleName}</span>
                    <span>⏱ {essay.data.readingTime}</span>
                  </div>
                  <h3 class="font-serif text-lg font-bold text-slate-100 mb-2 group-hover:text-cyan-400 transition-colors">
                    <a href={`/essays/${targetId}`}>
                      {essay.data.title}
                    </a>
                  </h3>
                  <p class="font-sans text-sm text-slate-400 line-clamp-2 mb-4">
                    {essay.data.description}
                  </p>
                </div>
                <a href={`/essays/${targetId}`} class="font-mono text-xs font-bold text-cyan-400 hover:underline flex items-center gap-1">
                  <span>阅读全文</span>
                  <span>→</span>
                </a>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="bg-slate-900 border border-slate-800 p-8 rounded-lg text-center font-mono text-xs text-slate-500">
          更多 {id} 专属研报正在由实验室研究员同行评审中，即将发布...
        </div>
      )}
    </div>

    <!-- Navigation Footer -->
    <div class="border-t border-slate-800 pt-8 flex justify-between items-center font-mono text-xs text-slate-400">
      {prevModule ? (
        <a href={`/modules/${prevModule.slug}`} class="hover:text-cyan-400 transition-colors flex items-center gap-2">
          <span>←</span>
          <span>{prevModule.name}</span>
        </a>
      ) : <div />}

      {nextModule ? (
        <a href={`/modules/${nextModule.slug}`} class="hover:text-cyan-400 transition-colors flex items-center gap-2">
          <span>{nextModule.name}</span>
          <span>→</span>
        </a>
      ) : <div />}
    </div>
  </div>
</Layout>
