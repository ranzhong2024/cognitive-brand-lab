---
import Layout from '../../layouts/Layout.astro';
import ModuleSectionCard from '../../components/ModuleSectionCard.astro';
import EssayCard from '../../components/EssayCard.astro';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [\n    {\n      params: { slug: 'm1-brand-foundations' },\n      props: {\n        id: 'M1',\n        title: 'M1 勘测心智：锁定真实生活场景与心智入口 (Demand Radar & Mental Sensing)',\n        description: '怎么让海外用户在产生需求的一瞬间，第一个想起你？基于 Byron Sharp CEPs 场景网格与 Clayton Christensen JTBD 任务雇佣理论。',\n        systemContext: 'Layer 01 • 基础层 (Foundation Layer)',\n        nextModule: { slug: 'm2-behavioral-science', name: 'M2: 信任质押与硬核公信力' },\n        prevModule: null,\n        sections: [\n          { number: '01', title: 'Byron Sharp CEPs 场景网格构建', desc: '5W1H 购买触发情境扫描，构建多维度心智检索通路与物理可得性。' },\n          { number: '02', title: 'Clayton Christensen JTBD 进展力学', desc: '推进力、拉动力、焦虑阻力与习惯惯性的四力平衡分析。' },\n          { number: '03', title: 'AEO 机器语义与主题簇确权', desc: '在 ChatGPT / Perplexity / Google SGE 知识图谱中建立第一信源索引。' },\n        ],\n      },\n    },\n    {\n      params: { slug: 'm2-behavioral-science' },\n      props: {\n        id: 'M2',\n        title: 'M2 信任质押：打造不可伪造的硬核公信力与品牌指纹 (Unfakeable Trust & Proof Pledge)',\n        description: '破译海外买家的信任防御机制，用 Michael Spence 昂贵信号与 Byron Sharp 独特品牌资产构建公信力护城河。',\n        systemContext: 'Layer 01 • 基础层 (Foundation Layer)',\n        nextModule: { slug: 'm3-strategic-pricing', name: 'M3: 价值定价与毛利工程' },\n        prevModule: { slug: 'm1-brand-foundations', name: 'M1: 勘测心智与需求雷达' },\n        sections: [\n          { number: '01', title: 'Michael Spence 昂贵信号单次穿越', desc: '为什么口头宣传是零价值的？如何用高成本不可伪造投入实现分离均衡。' },\n          { number: '02', title: 'Byron Sharp DBA 独特品牌资产网格', desc: '专属构型轮廓、色彩编码与声纹指纹的心智检索垄断。' },\n          { number: '03', title: 'Rory Sutherland 仰巴脚效应 (Pratfall Effect)', desc: '主动暴露适用边界与劝退非目标客群，反向倍增核心承诺的可信度。' },\n        ],\n      },\n    },\n    {\n      params: { slug: 'm3-strategic-pricing' },\n      props: {\n        id: 'M3',\n        title: 'M3 价值定价：依据心理账户与 WTP 锁死 65%+ 战略毛利 (Strategic Value Pricing)',\n        description: '怎么把商品卖得比对手贵 30%，还能捕获全部利润？拒绝亏本赚吆喝的恶性价格战。',\n        systemContext: 'Layer 02 • 战略层 (Strategy Layer)',\n        nextModule: { slug: 'm4-algorithmic-resonance', name: 'M4: 算法共振与创作者套利' },\n        prevModule: { slug: 'm2-behavioral-science', name: 'M2: 信任质押与硬核背书' },\n        sections: [\n          { number: '01', title: 'Hermann Simon 定价微积分与利润杠杆', desc: '1% 价格改善带来 11.1% 营业利润增长的微观机制。' },\n          { number: '02', title: 'McKinsey 价格瀑布漏损审计', desc: '堵住渠道佣金、运费逆向折损与 PPC 广告补贴黑洞。' },\n          { number: '03', title: 'Good-Better-Best 3 档阶梯利润沙盘', desc: '通过阶梯产品矩阵提取消费者剩余，主推款毛利锁定在 65%+。' },\n        ],\n      },\n    },\n    {\n      params: { slug: 'm4-algorithmic-resonance' },\n      props: {\n        id: 'M4',\n        title: 'M4 算法共振：素材即定向探针与创作者信誉套利 (Algorithmic Resonance)',\n        description: '为什么人工受众细分正在杀死利润？深度解构 Meta DLRM 算法拍卖动力学、说服知识模型 (PKM) 与红人白标授权。',\n        systemContext: 'Layer 03 • 规模层 (Scale Layer)',\n        nextModule: { slug: 'm5-conversion-engineering', name: 'M5: 极速转化与主权基建' },\n        prevModule: { slug: 'm3-strategic-pricing', name: 'M3: 价值定价与毛利工程' },\n        sections: [\n          { number: '01', title: 'Meta DLRM 现代推荐拍卖与 AL-CAT', desc: '素材即定向：用高维语义探针让千亿参数算法自动找人。' },\n          { number: '02', title: '说服知识模型 (PKM) 与准社会关系 (PSI)', desc: '为什么官方账号自夸被秒划走？借创作者信任资产击碎用户防御。' },\n          { number: '03', title: 'Broad 1-CBO 极简账户与 3 秒 Hook 模式库', desc: '认知冲突、极限酷刑测试与前后对比模式，实现 CPA 规模化降低。' },\n        ],\n      },\n    },\n    {\n      params: { slug: 'm5-conversion-engineering' },\n      props: {\n        id: 'M5',\n        title: 'M5 极速转化：极速转化科学与 100px 近地证据链 (Rapid Conversion Science)',\n        description: '让人脑 3 秒秒懂，让 AI 问答引擎主动首推。基于 MECLABS 启发式方程、System 1 直觉流畅性与 Core Web Vitals。',\n        systemContext: 'Layer 03 • 转化层 (Conversion Layer)',\n        nextModule: { slug: 'm6-compounding-retention', name: 'M6: 复利留存与因果度量' },\n        prevModule: { slug: 'm4-algorithmic-resonance', name: 'M4: 算法共振与创作者套利' },\n        sections: [\n          { number: '01', title: 'MECLABS 转化启发式方程深度拆解', desc: '动机 4m + 价值 3v + 激励 2(i-f) - 焦虑 2a 的全链路落地。' },\n          { number: '02', title: '100px 近地证据链与 3 秒首屏黄金三角', desc: '在结账 CTA 上下 100 像素内密织质保、时效、退换与安全支付防伪网。' },\n          { number: '03', title: 'Google Core Web Vitals 物理性能底线', desc: 'LCP < 1.0s, INP < 100ms, CLS = 0 与 Schema.org JSON-LD 结构化数据。' },\n        ],\n      },\n    },\n    {\n      params: { slug: 'm6-compounding-retention' },\n      props: {\n        id: 'M6',\n        title: 'M6 复利留存：复利留存与因果增量度量 (Compounding Retention & Causal Lab)',\n        description: '自适应行为流做管家，因果实验算清真利润。基于 Reforge 留存微笑曲线、沃顿商学院 BG/NBD 客户模型与 Rubin 因果推断。',\n        systemContext: 'Layer 04 • 复利层 (Compounding Layer)',\n        nextModule: null,\n        prevModule: { slug: 'm5-conversion-engineering', name: 'M5: 极速转化与主权基建' },\n        sections: [\n          { number: '01', title: 'Donald Rubin 潜在因果推断与 Geo-Lift Holdout', desc: '通过停投实验剔除自然截流假归因，测算真实的 iROAS 净现金流。' },\n          { number: '02', title: '沃顿商学院 Peter Fader BG/NBD 概率模型', desc: '后验存活概率 P(Alive) 精准分层与自适应生命周期动作。' },\n          { number: '03', title: '6 大核心自适应流与发信域名物理信誉', desc: 'Flow-First 架构贡献 50%~70% CRM 利润，严格遵循 SPF/DKIM/DMARC 治理。' },\n        ],\n      },\n    },\n  ];\n}\n\nconst { id, title, description, systemContext, nextModule, prevModule, sections } = Astro.props;\nconst allEssays = await getCollection('essays');\nconst essays = allEssays.filter((e) => e.data.module === id);\n\n// Per-module AEO / Schema.org JSON-LD (Course / DefinedTerm / Breadcrumbs)\nconst moduleUrl = `https://ranbrandos.com/modules/${Astro.params.slug}`;\n\nconst moduleSchema = {\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Course\",\n      \"@id\": `${moduleUrl}#course`,\n      \"name\": title,\n      \"description\": description,\n      \"provider\": {\n        \"@type\": \"Organization\",\n        \"@id\": \"https://ranbrandos.com/#organization\",\n        \"name\": \"品牌科学实验室™ (BRANDOS LAB™)\"\n      },\n      \"instructor\": {\n        \"@type\": \"Person\",\n        \"@id\": \"https://ranbrandos.com/#founder\"\n      },\n      \"hasCourseInstance\": {\n        \"@type\": \"CourseInstance\",\n        \"courseMode\": \"online\",\n        \"inLanguage\": \"zh-CN\"\n      }\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"@id\": `${moduleUrl}#breadcrumb`,\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"首页\",\n          \"item\": \"https://ranbrandos.com\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"BrandOS™ 模块架构\",\n          \"item\": \"https://ranbrandos.com/#brandos-matrix\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 3,\n          \"name\": `${id}: ${title}`,\n          \"item\": moduleUrl\n        }\n      ]\n    }\n  ]\n};\n---\n\n<Layout \n  title={`${title} | 品牌科学实验室 (BRANDOS LAB)`} \n  description={description}\n  customSchema={moduleSchema}\n>\n  <div class=\"max-w-6xl mx-auto px-5 md:px-8 py-16 sm:py-24\">\n    <!-- Breadcrumb -->\n    <nav aria-label=\"Breadcrumb\" class=\"flex items-center gap-2 font-mono text-xs text-slate-500 uppercase tracking-widest mb-8\">\n      <a href=\"/\" class=\"hover:text-cyan-400 transition-colors\">BRANDOS LAB</a>\n      <span>/</span>\n      <a href=\"/#brandos-matrix\" class=\"hover:text-cyan-400 transition-colors\">ENGINE</a>\n      <span>/</span>\n      <span class=\"text-cyan-400\">{id}</span>\n    </nav>\n\n    <!-- Header Block -->\n    <header class=\"border-b border-slate-800 pb-10 mb-12\">\n      <div class=\"inline-block font-mono text-xs font-bold text-cyan-400 bg-cyan-950/40 border border-cyan-800/40 px-2.5 py-1 rounded mb-4\">\n        {systemContext}\n      </div>\n      <h1 class=\"font-sans text-3xl sm:text-4xl md:text-5xl font-black text-slate-100 mb-4 leading-tight\">\n        {title}\n      </h1>\n      <p class=\"font-sans text-slate-400 text-base sm:text-lg max-w-3xl leading-relaxed\">\n        {description}\n      </p>\n    </header>\n\n    <!-- Key Sections Grid -->\n    <section class=\"mb-16\">\n      <h2 class=\"font-mono text-xs font-bold text-slate-400 uppercase tracking-[0.2em] mb-6\">\n        模块工程支柱 (ENGINEERING PILLARS)\n      </h2>\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        {sections.map((sec) => <ModuleSectionCard number={sec.number} title={sec.title} desc={sec.desc} />)}\n      </div>\n    </section>\n\n    <!-- Related Flagship Essays -->\n    <section class=\"mb-16 border-t border-slate-800 pt-12\">\n      <div class=\"flex justify-between items-end mb-8\">\n        <div>\n          <h2 class=\"font-mono text-xs font-bold text-cyan-400 uppercase tracking-[0.2em] mb-1\">\n            模块相关研报专著\n          </h2>\n          <p class=\"font-sans text-2xl font-bold text-slate-100\">\n            {id} 深度理论与实战案例单行本\n          </p>\n        </div>\n      </div>\n\n      {essays.length > 0 ? (\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          {essays.map((essay) => <EssayCard essay={essay} />)}\n        </div>\n      ) : (\n        <div class=\"bg-slate-900 border border-slate-800 p-8 rounded-lg text-center font-mono text-xs text-slate-500\">\n          更多 {id} 专属研报正在由实验室研究员同行评审中，即将发布...\n        </div>\n      )}\n    </section>\n\n    <!-- Navigation Footer -->\n    <footer class=\"border-t border-slate-800 pt-8 flex justify-between items-center font-mono text-xs text-slate-400\">\n      {prevModule ? (\n        <a href={`/modules/${prevModule.slug}`} class=\"hover:text-cyan-400 transition-colors flex items-center gap-2\">\n          <span>←</span>\n          <span>{prevModule.name}</span>\n        </a>\n      ) : <div />}\n\n      {nextModule ? (\n        <a href={`/modules/${nextModule.slug}`} class=\"hover:text-cyan-400 transition-colors flex items-center gap-2\">\n          <span>{nextModule.name}</span>\n          <span>→</span>\n        </a>\n      ) : <div />}\n    </footer>\n  </div>\n</Layout>\n