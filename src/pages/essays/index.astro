---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allEssays = await getCollection('essays');
allEssays.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout 
  title="品牌笔记与实证专著库 | 品牌科学实验室™ • BRANDOS LAB™"
  description="品牌科学实验室™（BRANDOS LAB™）出海实证专著库。收录 Byron Sharp、Michael Spence、因果推断等跨学科实操研究。"
  currentPath="/essays"
>
  <div class="max-w-6xl mx-auto w-full px-5 md:px-8 py-16 sm:py-24">
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-0.5 bg-cyan-950/60 border border-cyan-800/60 rounded-full font-mono text-[11px] font-bold text-cyan-400 uppercase tracking-[0.2em] mb-4">
        MONOGRAPH REPOSITORY
      </div>
      <h1 class="font-sans font-extrabold text-[32px] sm:text-[44px] text-slate-100 mb-4">
        品牌笔记与实证专著库
      </h1>
      <p class="font-sans text-slate-300 text-[16px] max-w-2xl">
        深入探讨全球高溢价品牌的底层工程机制与实证分析。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {allEssays.map((essay) => (
        <article class="bg-[#111622] border border-[#232B3E] hover:border-cyan-500/50 p-6 rounded-2xl flex flex-col justify-between transition-all group">
          <div>
            <div class="flex items-center gap-2 font-mono text-[11px] text-cyan-400 mb-3 font-bold">
              <span>{essay.data.module} • {essay.data.moduleName}</span>
              <span class="text-slate-500">• {essay.data.readingTime}</span>
            </div>
            <h2 class="font-sans font-bold text-[18px] text-slate-100 mb-2 group-hover:text-cyan-400 transition-colors">
              <a href={`/essays/${essay.slug}`}>
                {essay.data.title}
              </a>
            </h2>
            <p class="font-sans text-[14px] text-slate-300 line-clamp-3 mb-6">
              {essay.data.description}
            </p>
          </div>
          <a href={`/essays/${essay.slug}`} class="font-mono text-[12px] font-bold text-cyan-400 flex items-center justify-between pt-4 border-t border-[#232B3E]">
            <span>阅读全文 →</span>
            <span>→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>
