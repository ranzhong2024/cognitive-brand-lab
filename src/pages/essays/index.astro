---
import Layout from '../../layouts/Layout.astro';
import EssayCard from '../../components/EssayCard.astro';
import { getCollection } from 'astro:content';

const essays = await getCollection('essays');
essays.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const modulesList = [
  { id: 'ALL', name: '全部专著', count: essays.length },
  { id: 'M1', name: 'M1 勘测心智', count: essays.filter(e => e.data.module === 'M1').length },
  { id: 'M2', name: 'M2 立住人设', count: essays.filter(e => e.data.module === 'M2').length },
  { id: 'M3', name: 'M3 价值定价', count: essays.filter(e => e.data.module === 'M3').length },
  { id: 'M4', name: 'M4 算法共振', count: essays.filter(e => e.data.module === 'M4').length },
  { id: 'M5', name: 'M5 极速转化', count: essays.filter(e => e.data.module === 'M5').length },
  { id: 'M6', name: 'M6 复利留存', count: essays.filter(e => e.data.module === 'M6').length },
];

const archiveSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://ranbrandos.com/essays#collection",
      "name": "品牌笔记与实证专著库 | 品牌科学实验室™",
      "description": "收录 Ran (然) 的品牌战略实证手记、出海课程深度拆解、诺奖理论还原与企业实战工程专著。拒绝营销玄学，输出最高认知密度的品牌科学指南。",
      "url": "https://ranbrandos.com/essays",
      "author": {
        "@type": "Person",
        "@id": "https://ranbrandos.com/#founder"
      },
      "publisher": {
        "@type": "Organization",
        "@id": "https://ranbrandos.com/#organization"
      },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": essays.length,
        "itemListElement": essays.map((essay, idx) => ({
          "@type": "ListItem",
          "position": idx + 1,
          "name": `${essay.data.module}: ${essay.data.title}`,
          "url": `https://ranbrandos.com/essays/${essay.id}`
        }))
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://ranbrandos.com/essays#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首页",
          "item": "https://ranbrandos.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "品牌笔记 (Brand Notes)",
          "item": "https://ranbrandos.com/essays"
        }
      ]
    }
  ]
};
---

<Layout 
  title="品牌笔记与实证专著库 | 品牌科学实验室™ • BRANDOS LAB™"
  description="收录 Ran (然) 的品牌战略实证手记、出海课程深度拆解、诺奖理论还原与企业实战工程专著。拒绝营销玄学，输出最高认知密度的品牌科学指南。"
  currentPath="/essays"
  customSchema={archiveSchema}
>
  <div class="max-w-6xl mx-auto px-5 md:px-8 py-16 sm:py-24 relative z-10">
    
    <!-- Hero Banner Card -->
    <div class="bg-[#111622] border border-[#232B3E] rounded-3xl p-6 sm:p-10 mb-12 relative overflow-hidden shadow-2xl">
      <div class="absolute -top-32 -right-32 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-cyan-950/60 border border-cyan-800/60 rounded-full font-mono text-[11px] font-bold text-cyan-400 uppercase tracking-[0.2em] mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
            KNOWLEDGE BASE // 品牌科学实证专著
          </div>
          <h1 class="font-sans font-black text-[32px] sm:text-[46px] text-slate-100 mb-4 leading-tight">
            品牌笔记与实证专著库
          </h1>
          <p class="font-sans text-[15px] sm:text-[17px] text-slate-300 leading-relaxed max-w-2xl">
            收录 Ran (然) 的出海品牌战略手记、诺贝尔奖理论还原、价格沙盘与因果留存工程专著。持续更新原创内容，为中国出海企业构建带得走、抢不走的永久心智资产。
          </p>
        </div>

        <div class="lg:col-span-5 aspect-[16/9] rounded-2xl overflow-hidden border border-[#232B3E] bg-[#09090B] shadow-inner">
          <img 
            src="/images/brand-notes-banner.jpg" 
            alt="Brand Notes Masterclass Repository"
            class="w-full h-full object-cover pointer-events-none select-none"
          />
        </div>
      </div>
    </div>

    <!-- Search & Dynamic Filter Controls -->
    <div class="bg-[#111622]/90 border border-[#232B3E] p-4 sm:p-5 rounded-2xl mb-12 backdrop-blur-md flex flex-col md:flex-row items-center justify-between gap-4">
      <!-- Search Input -->
      <div class="relative w-full md:w-80">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 font-mono text-[13px]">
          🔍
        </span>
        <input 
          type="text" 
          id="essay-search-input"
          placeholder="搜索关键词：定价、差评、达人、LTV..." 
          class="w-full bg-[#09090B] border border-[#232B3E] focus:border-cyan-400 text-slate-100 placeholder-slate-500 text-[13px] rounded-xl pl-9 pr-4 py-2.5 font-sans transition-colors outline-none"
        />
      </div>

      <!-- Module Filter Tabs -->
      <div class="flex flex-wrap items-center gap-2 w-full md:w-auto overflow-x-auto" id="module-filter-bar">
        {modulesList.map((m) => (
          <button 
            type="button"
            data-filter={m.id}
            class={`filter-btn px-3.5 py-2 rounded-xl font-mono text-[12px] font-bold transition-all ${m.id === 'ALL' ? 'bg-cyan-400 text-[#09090B] shadow-[0_0_15px_rgba(0,242,254,0.3)]' : 'bg-[#09090B] border border-[#232B3E] hover:border-slate-500 text-slate-300 hover:text-white'}`}
          >
            <span>{m.name}</span>
            <span class="ml-1 text-[10px] opacity-70">({m.count})</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Notes Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="essays-grid">
      {essays.map((essay) => (
        <EssayCard essay={essay} />
      ))}
    </div>

    <!-- Empty Search Fallback State -->
    <div id="no-results" class="hidden text-center py-20 bg-[#111622] border border-[#232B3E] rounded-2xl p-8">
      <div class="text-[32px] mb-3">🔍</div>
      <h3 class="font-sans font-bold text-[20px] text-slate-200 mb-2">未找到匹配的品牌笔记</h3>
      <p class="text-slate-400 text-[14px] max-w-md mx-auto mb-6">
        请尝试更换搜索关键词，或点击上方模块分类查看全部专著。
      </p>
      <button 
        type="button"
        id="reset-search-btn"
        class="px-5 py-2.5 rounded-xl bg-cyan-400 text-[#09090B] font-mono text-[12px] font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors"
      >
        重置搜索与筛选
      </button>
    </div>

    <!-- Bottom Consultation CTA -->
    <section class="mt-24 border-t border-[#232B3E] pt-16">
      <div class="bg-gradient-to-b from-[#111622] to-[#0A0D14] border-2 border-cyan-500/50 rounded-3xl p-8 sm:p-12 text-center relative overflow-hidden shadow-[0_0_40px_rgba(0,242,254,0.1)]">
        <h2 class="font-sans font-black text-[24px] sm:text-[34px] text-slate-100 mb-4 tracking-tight">
          与其在价格战里继续内卷，不如从今天开启你的品牌之路。
        </h2>
        <p class="font-sans text-slate-300 text-[15px] sm:text-[16px] max-w-xl mx-auto mb-8 leading-relaxed">
          阅读完专著如有出海品牌战略、商业分析或数据归因咨询需求，欢迎直接来信。
        </p>
        <a 
          href="mailto:ranzhongus@icloud.com?subject=BrandOS%20%E5%93%81%E7%89%8C%E7%B3%BB%E7%BB%9F%E5%92%A8%E8%AF%A2&body=%E6%82%A8%E5%A5%BD%20Ran%EF%BC%8C%E6%88%91%E5%9C%A8%E9%98%85%E8%AF%BB%E4%BA%86%E5%93%81%E7%89%8C%E7%AC%94%E8%AE%B0%E5%90%8E%EF%BC%8C%E5%B8%8C%E6%9C%9B%E6%8E%A2%E8%AE%A8%E5%A6%82%E4%BD%95%E4%B8%BA%E6%88%91%E4%BB%AC%E7%9A%84%E4%BA%A7%E5%93%81%E6%90%AD%E5%BB%BA%20BrandOS%20%E5%93%81%E7%89%8C%E6%93%8D%E4%BD%9C%E7%B3%BB%E7%BB%9F%E3%80%82"
          class="inline-flex items-center gap-3 bg-slate-100 hover:bg-cyan-400 text-[#09090B] px-8 py-4 rounded-xl font-mono text-[14px] font-extrabold uppercase tracking-wider transition-all duration-200 hover:shadow-[0_0_30px_rgba(0,242,254,0.4)] group"
        >
          <span>马上咨询</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </section>
  </div>

  <!-- Client-Side Reactive Search & Filter Engine -->
  <script>
    function setupEssayFilters() {
      const searchInput = document.getElementById('essay-search-input') as HTMLInputElement | null;
      const filterBtns = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.essay-card');
      const noResults = document.getElementById('no-results');
      const resetBtn = document.getElementById('reset-search-btn');

      if (!cards.length) return;

      let currentModule = 'ALL';
      let currentQuery = '';

      // Check URL hash on page load (e.g. #M2)
      if (window.location.hash) {
        const hashModule = window.location.hash.replace('#', '').toUpperCase();
        if (['M1', 'M2', 'M3', 'M4', 'M5', 'M6'].includes(hashModule)) {
          currentModule = hashModule;
        }
      }

      function updateUI() {
        // Update button states
        filterBtns.forEach(btn => {
          const mod = btn.getAttribute('data-filter');
          if (mod === currentModule) {
            btn.className = 'filter-btn px-3.5 py-2 rounded-xl font-mono text-[12px] font-bold transition-all bg-cyan-400 text-[#09090B] shadow-[0_0_15px_rgba(0,242,254,0.3)]';
          } else {
            btn.className = 'filter-btn px-3.5 py-2 rounded-xl font-mono text-[12px] font-bold transition-all bg-[#09090B] border border-[#232B3E] hover:border-slate-500 text-slate-300 hover:text-white';
          }
        });

        // Filter cards
        let visibleCount = 0;
        cards.forEach(card => {
          const cardEl = card as HTMLElement;
          const cardModule = cardEl.getAttribute('data-module') || '';
          const cardTitle = cardEl.getAttribute('data-title') || '';
          const cardDesc = cardEl.getAttribute('data-desc') || '';

          const matchesModule = currentModule === 'ALL' || cardModule === currentModule;
          const matchesQuery = !currentQuery || cardTitle.includes(currentQuery) || cardDesc.includes(currentQuery);

          if (matchesModule && matchesQuery) {
            cardEl.style.display = 'flex';
            visibleCount++;
          } else {
            cardEl.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          currentModule = btn.getAttribute('data-filter') || 'ALL';
          if (currentModule !== 'ALL') {
            window.location.hash = currentModule;
          } else {
            history.replaceState(null, '', window.location.pathname);
          }
          updateUI();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
          updateUI();
        });
      }

      if (resetBtn && searchInput) {
        resetBtn.addEventListener('click', () => {
          currentModule = 'ALL';
          currentQuery = '';
          searchInput.value = '';
          history.replaceState(null, '', window.location.pathname);
          updateUI();
        });
      }

      updateUI();
    }

    setupEssayFilters();
    document.addEventListener('astro:page-load', setupEssayFilters);
  </script>
</Layout>
