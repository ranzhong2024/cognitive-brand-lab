---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const essays = await getCollection('essays');
// Sort by pubDate descending
const sortedEssays = essays.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout 
  title="Empirical Essays & Archive | Cognitive Brand Lab • RAN BRAND OS™"
  description="认知品牌科学实验室实战内参归档索引。收录基于全球学术界与一线操盘实证的深度品牌战略研究报告。"
  currentPath="/essays"
>
  <div class="max-w-max-width mx-auto w-full px-4 md:px-margin py-12 md:py-stack-lg flex flex-col gap-stack-lg">
    <!-- Header Section -->
    <header class="border-b border-outline-variant pb-stack-md">
      <span class="font-mono text-[12px] text-secondary uppercase tracking-widest block mb-2">RESEARCH ARCHIVE / 实证文献库</span>
      <h1 class="font-headline-md text-[28px] md:text-headline-md text-on-surface mb-stack-sm">
        全部前沿实战内参索引
      </h1>
      <p class="font-body-md text-body-md text-secondary max-w-3xl leading-relaxed">
        收录由 Cognitive Brand Lab 独立发布的深度研究报告、方法论解析与出海商业架构文献。按模块与时间编目索引。
      </p>
    </header>

    <!-- Search & Filter Area -->
    <section class="flex flex-col md:flex-row gap-gutter justify-between items-end">
      <!-- Search Input -->
      <div class="w-full md:w-1/3 relative">
        <span class="material-symbols-outlined absolute left-0 bottom-2 text-secondary text-[20px]">search</span>
        <input 
          id="archive-search" 
          class="w-full bg-transparent border-0 border-b border-outline-variant pb-2 pl-8 text-body-md font-body-md text-on-surface placeholder:text-outline focus:border-primary focus:ring-0 transition-colors" 
          placeholder="搜索文献、框架或关键词..." 
          type="text"
        />
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap gap-4 mt-stack-md md:mt-0 font-label-caps text-label-caps uppercase tracking-wider">
        <span class="text-secondary py-1">筛选模块:</span>
        <button class="text-primary font-bold border-b-2 border-primary pb-0.5">全部 ({sortedEssays.length})</button>
        <button class="text-secondary hover:text-primary transition-colors pb-0.5">M01 品牌基石</button>
        <button class="text-secondary hover:text-primary transition-colors pb-0.5">M02 行为科学</button>
        <button class="text-secondary hover:text-primary transition-colors pb-0.5">M03 战略定价</button>
      </div>
    </section>

    <!-- Research Archive Table -->
    <section class="w-full overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[800px]">
        <thead>
          <tr>
            <th class="font-label-caps text-label-caps text-secondary font-normal pb-3 border-b border-outline-variant uppercase tracking-wider w-1/6">模块编号</th>
            <th class="font-label-caps text-label-caps text-secondary font-normal pb-3 border-b border-outline-variant uppercase tracking-wider w-1/2">文献标题与核心主旨</th>
            <th class="font-label-caps text-label-caps text-secondary font-normal pb-3 border-b border-outline-variant uppercase tracking-wider w-1/6">类型</th>
            <th class="font-label-caps text-label-caps text-secondary font-normal pb-3 border-b border-outline-variant uppercase tracking-wider w-1/12 text-right">阅读时间</th>
            <th class="font-label-caps text-label-caps text-secondary font-normal pb-3 border-b border-outline-variant uppercase tracking-wider w-1/12 text-right">发布日期</th>
          </tr>
        </thead>
        <tbody class="font-body-md text-body-md text-on-surface">
          {sortedEssays.map((essay) => (
            <tr class="hover:bg-surface-container-low transition-colors group cursor-pointer" onclick={`window.location.href='/essays/${essay.slug}'`}>
              <td class="py-5 border-b border-outline-variant">
                <span class="font-mono text-[12px] bg-surface-container text-primary font-bold px-2 py-1 border border-outline-variant">
                  {essay.data.module}
                </span>
              </td>
              <td class="py-5 border-b border-outline-variant font-medium pr-6">
                <a href={`/essays/${essay.slug}`} class="block">
                  <span class="font-headline-sm text-[17px] font-bold text-primary group-hover:text-accent-blue transition-colors">
                    {essay.data.title}
                  </span>
                  <span class="block text-[13px] text-secondary mt-1 font-normal line-clamp-1">
                    {essay.data.description}
                  </span>
                </a>
              </td>
              <td class="py-5 border-b border-outline-variant text-secondary text-[14px]">
                {essay.data.moduleName}
              </td>
              <td class="py-5 border-b border-outline-variant text-secondary font-mono text-[13px] text-right">
                {essay.data.readingTime}
              </td>
              <td class="py-5 border-b border-outline-variant text-secondary font-mono text-[13px] text-right">
                {essay.data.pubDate.toISOString().slice(0, 7)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
</Layout>
