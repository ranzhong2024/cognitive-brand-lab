---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content, headings } = await render(essay);
const essaySlug = essay.id;

// Related essays from other modules
const allEssays = await getCollection('essays');
const relatedEssays = allEssays.filter((e) => e.id !== essay.id).slice(0, 2);

// Module Color Mapping
const moduleColors: Record<string, { badge: string; border: string; accent: string }> = {
  M1: { badge: 'text-cyan-400 bg-cyan-950/60 border-cyan-800/60', border: 'border-cyan-500/40', accent: '#00F2FE' },
  M2: { badge: 'text-indigo-400 bg-indigo-950/60 border-indigo-800/60', border: 'border-indigo-500/40', accent: '#818CF8' },
  M3: { badge: 'text-emerald-400 bg-emerald-950/60 border-emerald-800/60', border: 'border-emerald-500/40', accent: '#10B981' },
  M4: { badge: 'text-amber-400 bg-amber-950/60 border-amber-800/60', border: 'border-amber-500/40', accent: '#F59E0B' },
  M5: { badge: 'text-rose-400 bg-rose-950/60 border-rose-800/60', border: 'border-rose-500/40', accent: '#F43F5E' },
  M6: { badge: 'text-purple-400 bg-purple-950/60 border-purple-800/60', border: 'border-purple-500/40', accent: '#A855F7' },
};

const style = moduleColors[essay.data.module] || moduleColors.M1;
const publishDateIso = essay.data.pubDate ? new Date(essay.data.pubDate).toISOString() : new Date().toISOString();

// Background AEO / Schema.org JSON-LD (Invisible to human readers, 100% ingested by AI Answer Engines & Search Bots)
const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `https://ranbrandos.com/essays/${essay.id}#article`,
      "headline": essay.data.title,
      "description": essay.data.description,
      "datePublished": publishDateIso,
      "dateModified": publishDateIso,
      "mainEntityOfPage": `https://ranbrandos.com/essays/${essay.id}`,
      "author": {
        "@type": "Person",
        "name": "Ran (然)",
        "jobTitle": "Lead Brand Architect & Founder",
        "url": "https://ranbrandos.com/about"
      },
      "publisher": {
        "@type": "Organization",
        "name": "品牌科学实验室™ (BRANDOS LAB™)",
        "logo": {
          "@type": "ImageObject",
          "url": "https://ranbrandos.com/logo/brandos_official_logo.jpg"
        }
      },
      "keywords": [essay.data.module, essay.data.moduleName, "出海品牌", "BrandOS", "品牌科学", ...(essay.data.tags || [])]
    }
  ]
};
---

<Layout 
  title={`${essay.data.title} | 品牌笔记 • 品牌科学实验室™`}
  description={essay.data.description}
  type="article"
  publishDate={publishDateIso}
  customSchema={articleSchema}
  currentPath="/essays"
>
  <!-- Top Reading Progress Indicator -->
  <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-cyan-400 via-indigo-500 to-emerald-400 z-[100] transition-all duration-75" style="width: 0%;"></div>

  <div class="max-w-6xl mx-auto px-5 md:px-8 py-12 sm:py-20 relative z-10">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 font-mono text-[11px] sm:text-[12px] text-slate-500 uppercase tracking-widest mb-8">
      <a href="/" class="hover:text-cyan-400 transition-colors">BRANDOS LAB™</a>
      <span>/</span>
      <a href="/essays" class="hover:text-cyan-400 transition-colors">品牌笔记</a>
      <span>/</span>
      <span class="text-cyan-400">{essay.data.module}</span>
    </nav>

    <!-- Article Header -->
    <header class="border-b border-[#232B3E] pb-10 mb-12">
      <div class="flex flex-wrap items-center gap-3 mb-5">
        <span class={`font-mono text-[11px] font-extrabold px-3 py-1 rounded uppercase tracking-wider border ${style.badge}`}>
          {essay.data.module} • {essay.data.moduleName}
        </span>
        <span class="font-mono text-[12px] text-slate-400">
          ⏱ 预计阅读：{essay.data.readingTime}
        </span>
        <span class="font-mono text-[12px] text-slate-500">
          • 发布日期：{publishDateIso.slice(0, 10)}
        </span>
        <span class="font-mono text-[12px] text-slate-400 ml-auto">
          作者：<strong class="text-slate-200">{essay.data.author || "Ran (然)"}</strong>
        </span>
      </div>

      <h1 class="font-serif text-[30px] sm:text-[44px] font-bold text-slate-100 leading-tight mb-6">
        {essay.data.title}
      </h1>

      <p class="font-sans text-slate-300 text-[16px] sm:text-[18px] leading-relaxed max-w-4xl border-l-2 border-cyan-500/50 pl-4 py-1 italic bg-cyan-950/10 rounded-r">
        {essay.data.description}
      </p>
    </header>

    <!-- Main Content Layout with Sticky TOC Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Sticky Sidebar: Headings TOC & Engine Anchor -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-28 space-y-6">
        <!-- Module Context Card -->
        <div class="bg-[#111622] border border-[#232B3E] p-5 rounded-2xl">
          <div class="font-mono text-[10px] text-slate-500 uppercase tracking-widest mb-2">所属系统模块</div>
          <div class="flex items-center justify-between mb-3">
            <span class="font-mono text-[14px] font-bold text-cyan-400">{essay.data.module} 操作系统</span>
            <a href={`/modules/${essay.data.module.toLowerCase()}-brand-foundations`} class="font-mono text-[11px] text-slate-400 hover:text-cyan-400">查看框架 →</a>
          </div>
          <p class="font-sans text-[12.5px] text-slate-400 leading-normal">
            {essay.data.moduleName}：解构全球高溢价品牌资产沉淀与认知护城河。
          </p>
        </div>

        <!-- Table of Contents -->
        {headings.length > 0 && (
          <div class="bg-[#111622] border border-[#232B3E] p-5 rounded-2xl max-h-[60vh] overflow-y-auto">
            <div class="font-mono text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-4 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
              文章目录结构 (TOC)
            </div>
            <nav class="space-y-2 font-sans text-[13px]">
              {headings.filter(h => h.depth <= 3).map(h => (
                <a 
                  href={`#${h.slug}`} 
                  class={`block text-slate-400 hover:text-cyan-400 transition-colors leading-snug ${h.depth === 3 ? 'pl-3 text-[12px] text-slate-500' : 'font-medium'}`}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        )}
      </aside>

      <!-- Right Main Prose Column -->
      <main class="lg:col-span-8 max-w-none">
        <!-- Markdown Prose Container -->
        <article class="prose prose-invert prose-cyan max-w-none prose-headings:font-serif prose-headings:font-bold prose-h2:text-[24px] prose-h2:sm:text-[28px] prose-h2:border-b prose-h2:border-[#232B3E] prose-h2:pb-3 prose-h2:mt-12 prose-h3:text-[19px] prose-h3:text-cyan-300 prose-p:text-slate-300 prose-p:text-[15px] prose-p:leading-relaxed prose-blockquote:border-l-cyan-400 prose-blockquote:bg-[#111622] prose-blockquote:p-4 prose-blockquote:rounded-r-lg prose-blockquote:text-slate-300 prose-code:font-mono prose-code:text-cyan-300 prose-code:bg-cyan-950/40 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-pre:bg-[#09090B] prose-pre:border prose-pre:border-[#232B3E] prose-pre:rounded-xl prose-img:rounded-2xl prose-img:border prose-img:border-[#232B3E] prose-img:shadow-2xl prose-table:border prose-table:border-[#232B3E] prose-th:bg-[#111622] prose-th:p-3 prose-td:p-3 prose-td:border-t prose-td:border-[#232B3E]">
          <Content />
        </article>

        <!-- Tags Row -->
        {essay.data.tags && essay.data.tags.length > 0 && (
          <div class="mt-14 pt-8 border-t border-[#232B3E] flex flex-wrap items-center gap-2">
            <span class="font-mono text-[11px] text-slate-500 mr-2">TAGS:</span>
            {essay.data.tags.map((tag: string) => (
              <span class="font-mono text-[11px] bg-[#111622] border border-[#232B3E] text-slate-400 px-3 py-1 rounded-full">
                #{tag}
              </span>
            ))}
          </div>
        )}

        <!-- Author / Citation Sign-off Card -->
        <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-[#111622] to-[#09090B] border border-cyan-500/20 flex flex-col sm:flex-row items-center gap-6">
          <div class="w-16 h-16 rounded-full bg-cyan-950 border border-cyan-400 flex items-center justify-center font-serif text-2xl font-bold text-cyan-400 shrink-0 shadow-[0_0_20px_rgba(0,242,254,0.2)]">
            然
          </div>
          <div>
            <div class="font-mono text-[11px] text-cyan-400 font-bold uppercase tracking-wider mb-1">
              单行本专著责任作者 (PRINCIPAL INVESTIGATOR)
            </div>
            <div class="font-serif text-[18px] font-bold text-slate-100 mb-1">
              Ran (然) • 品牌科学实验室架构师
            </div>
            <p class="font-sans text-[13px] text-slate-400 leading-relaxed mb-3">
              专注于出海品牌底层心智勘测、定价毛利工程与因果留存体系。拒绝口号营销，用行为经济学与实证科学为企业沉淀不可动摇的心智资产。
            </p>
            <a href="/about" class="font-mono text-[11px] font-bold text-cyan-400 hover:underline flex items-center gap-1">
              <span>阅读研究员完整背景与投资分析哲学</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Related Essays -->
        {relatedEssays.length > 0 && (
          <div class="mt-16 pt-10 border-t border-[#232B3E]">
            <h4 class="font-mono text-[12px] font-bold text-slate-400 uppercase tracking-widest mb-6">
              📚 延伸研读 (RECOMMENDED ESSAYS)
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedEssays.map((rel) => (
                <a 
                  href={`/essays/${rel.id}`}
                  class="bg-[#111622] border border-[#232B3E] hover:border-cyan-400 p-5 rounded-xl transition-all group block"
                >
                  <div class="font-mono text-[10px] text-cyan-400 font-bold uppercase mb-1">
                    {rel.data.module} • {rel.data.moduleName}
                  </div>
                  <div class="font-sans font-bold text-[14px] text-slate-200 group-hover:text-cyan-400 transition-colors line-clamp-2 leading-snug">
                    {rel.data.title}
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Back to Archive -->
        <div class="mt-12 text-center">
          <a 
            href="/essays" 
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#111622] border border-[#232B3E] hover:border-cyan-400 text-slate-300 hover:text-white font-mono text-[12px] font-bold uppercase transition-colors"
          >
            <span>← 返回全部品牌笔记</span>
          </a>
        </div>
      </main>
    </div>
  </div>

  <!-- Reading Progress Tracker Script -->
  <script is:inline>
    function setupReadingProgress() {
      const updateBar = () => {
        const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        const bar = document.getElementById('reading-progress');
        if (bar) bar.style.width = scrolled + '%';
      };

      window.addEventListener('scroll', updateBar, { passive: true });
    }

    setupReadingProgress();
    document.addEventListener('astro:page-load', setupReadingProgress);
  </script>
</Layout>
