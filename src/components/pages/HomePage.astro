---
import Layout from '../../layouts/Layout.astro';
import MatrixSection from '../MatrixSection.astro';
import EssayCard from '../EssayCard.astro';
import { getCollection } from 'astro:content';
import { getEssaySlug, getLocalizedPath, sortEssaysByModule, type Lang } from '../../utils/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const isEn = lang === 'en';

const stats = isEn
  ? [
      { num: '6', label: 'BrandOS™ Modules' },
      { num: '65%+', label: 'Target Gross Margin' },
      { num: '400%+', label: 'Scale Case Velocity' },
      { num: '100%', label: 'Causal Incrementality' },
    ]
  : [
      { num: '6', label: 'BrandOS™ 模块' },
      { num: '65%+', label: '目标健康毛利底线' },
      { num: '400%+', label: '标杆爆发实证增速' },
      { num: '100%', label: '因果留存科学度量' },
    ];

const methodologySteps = isEn
  ? [
      {
        num: '01',
        title: 'Survey Reality & Uncover Push',
        desc: 'Scraping 200+ negative reviews and Reddit threads to extract authentic buyer push and anxieties before launching broad creative targeting.',
      },
      {
        num: '02',
        title: 'Stake Unfakeable Costly Signals',
        desc: 'Replacing shallow lifestyle slogans with verifiable, hard-to-fake technical disclosures and risk-reversing guarantees that crush purchase anxiety.',
      },
      {
        num: '03',
        title: 'Engineer Strategic Pricing & Margins',
        desc: 'Designing price waterfalls and GBB tier structures to defend a 65%+ gross margin floor, preventing premature cash bleed in ad auctions.',
      },
      {
        num: '04',
        title: 'Drive Algorithmic Resonance & Retention',
        desc: 'Fueling Meta Andromeda broad targeting with hook-dense creative assets, paired with causal GeoLift experimentation to compound true organic retention.',
      },
    ]
  : [
      {
        num: '01',
        title: '勘测真实心智，挖掘高压刺痛',
        desc: '用 1-3 星差评与社区吐槽提炼高唤醒 CEP 与核心 Push/Anxiety 恐惧清单，在烧大词投流前锁定买家真实待办任务（JTBD）。',
      },
      {
        num: '02',
        title: '质押不可伪造的昂贵信任信号',
        desc: '用斯宾塞信号论与极端工况实测替代廉价鸡汤口号，以不可逆违约成本瞬间瓦解海外买家的换新戒备与被骗焦虑。',
      },
      {
        num: '03',
        title: '设计价格瀑布，守死高毛利底线',
        desc: '搭建 GBB 三档阶梯沙盘与口袋毛利瀑布，把毛利率死死焊在 65%+ 安全线之上，为后续高研发与算法投流储备充足燃料。',
      },
      {
        num: '04',
        title: '算法共振破圈，实验度量复利留存',
        desc: '用高冲突高信息密度素材喂饱 Meta Broad 算法，并以严格因果实验（GeoLift）剥离渠道自嗨与老客截胡，做大真实有机增长复利。',
      },
    ];

const ecosystemPillars = isEn
  ? [
      {
        category: 'Diagnostic OS',
        title: 'BrandOS™ Strategic Matrix',
        desc: 'A complete end-to-end framework spanning M1 Demand Radar to M6 Compounding Retention, engineered specifically for cross-border brand leaders.',
      },
      {
        category: 'Research & Case Studies',
        title: 'In-Depth Case Notes & Audits',
        desc: 'Deep-dive architectural dissections of global benchmarks and failures: Stanley, Owala, Allbirds, Humane AI Pin, EcoFlow, and Anker SOLIX.',
      },
      {
        category: 'Advisory & Implementation',
        title: 'Direct Advisory & Executive Retainers',
        desc: 'Collaborating directly with global DTC founders and leadership teams to architect resilient cognitive moats and sustainable profitability.',
      },
    ]
  : [
      {
        category: '战略诊断系统',
        title: 'BrandOS™ 品牌战略矩阵',
        desc: '从 M1 勘测心智到 M6 复利留存的完整闭环，专为全球化出海品牌打造的硬核认知资本论与数字营销大一统操作系统。',
      },
      {
        category: '研报与案例库',
        title: '深度研报与全球商战复盘',
        desc: '以实证数据和底层原理解构全球爆品与折戟先锋：Stanley、Owala、Allbirds、Humane AI Pin、EcoFlow、Anker SOLIX 与耐克/阿迪战局。',
      },
      {
        category: '咨询与陪跑',
        title: '高阶品牌系统咨询与陪跑',
        desc: '直接面向出海品牌创始人与核心高管，提供顶层品牌认知架构、定价沙盘推演与算法共振投流治理咨询，打造长效壁垒。',
      },
    ];

const allEssays = sortEssaysByModule(
  (await getCollection('essays')).filter((e) => e.data.lang === lang)
);

const featuredEssay = allEssays.find((e) => e.data.featured) || allEssays[0];
const otherEssays = allEssays.filter((e) => e.id !== featuredEssay?.id);
const featuredHref = featuredEssay ? getLocalizedPath(`/essays/${getEssaySlug(featuredEssay)}`, lang) : getLocalizedPath('/essays', lang);
const featuredDate = featuredEssay?.data?.pubDate ? new Date(featuredEssay.data.pubDate).toISOString().slice(0, 10) : '2026-08-24';
const essaysIndexHref = getLocalizedPath('/essays', lang);

const mailtoHref = isEn
  ? 'mailto:ranzhongus@icloud.com?subject=BrandOS%20Architecture%20Inquiry&body=Hi%20Ran%2C%20I%27m%20building%20a%20global%20DTC%20brand%20and%20would%20like%20to%20discuss%20implementing%20BrandOS.'
  : 'mailto:ranzhongus@icloud.com?subject=BrandOS%20%E5%93%81%E7%89%8C%E7%B3%BB%E7%BB%9F%E5%92%A8%E8%AF%A2&body=%E6%82%A8%E5%A5%BD%20Ran%EF%BC%8C%E6%88%91%E6%AD%A3%E5%9C%A8%E5%81%9A%E5%87%BA%E6%B5%B7%E4%B8%9A%E5%8A%A1%EF%BC%8C%E5%B8%8C%E6%9C%9B%E6%8E%A2%E8%AE%A8%E5%A6%82%E4%BD%95%E4%B8%BA%E6%88%91%E4%BB%AC%E7%9A%84%E4%BA%A7%E5%93%81%E6%90%AD%E5%BB%BA%20BrandOS%20%E5%93%81%E7%89%8C%E6%93%8D%E4%BD%9C%E7%B3%BB%E7%BB%9F%E3%80%82';
---

<Layout
  lang={lang}
  title={isEn ? 'BrandOS Lab™ | Global DTC Brand Strategy & Cognitive Operating System' : 'BrandOS Lab™ | 品牌科学实验室™ - 全球高溢价出海品牌认知资本论与数字营销大一统操作系统'}
  description={isEn ? 'BrandOS Lab™ provides a unified cognitive operating system for global DTC leaders: demand reconnaissance, costly signaling, strategic pricing, algorithmic resonance, and compounding retention.' : 'BrandOS Lab™ (品牌科学实验室) 专为全球化出海品牌打造：跨越从 M1 心智勘测到 M6 复利留存的 6 大模块，解构高溢价品牌认知资本论，拒绝无底线打折与低效投流。'}
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 overflow-hidden border-b border-[#232B3E]">
    <!-- Ambient Glow FX -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-gradient-to-r from-cyan-500/10 via-sky-500/10 to-indigo-500/10 blur-[130px] rounded-full pointer-events-none -z-10"></div>
    <div class="absolute top-10 left-10 w-72 h-72 bg-cyan-500/5 blur-[90px] rounded-full pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <!-- System Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-cyan-500/30 bg-cyan-950/40 text-cyan-300 font-mono text-[11px] sm:text-[12px] font-bold tracking-wider uppercase mb-8 shadow-[0_0_20px_rgba(0,242,254,0.15)] animate-fade-in">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>{isEn ? 'Unified Brand Operating System • Version 3.2' : '出海品牌认知资本论与数字营销大一统操作系统 • v3.2'}</span>
        </div>

        <!-- Main Headline -->
        <h1 class="font-sans font-extrabold text-[34px] sm:text-[54px] lg:text-[62px] text-slate-100 tracking-tight leading-[1.12] mb-6">
          {isEn ? (
            <>
              Stop Gambling on Discounts. <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-300">
                Architect Unfakeable Cognitive Moats.
              </span>
            </>
          ) : (
            <>
              别再靠降价促销给品牌续命了。<br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-300">
                用不可伪造的认知资本，砌死高溢价护城河。
              </span>
            </>
          )}
        </h1>

        <!-- Subheading -->
        <p class="font-sans text-[16px] sm:text-[19px] text-slate-300 leading-relaxed max-w-3xl mx-auto mb-10">
          {isEn
            ? 'BrandOS Lab™ codifies global brand science into six rigorous, actionable engineering modules. We help cross-border DTC founders eliminate agency vanity metrics, defend 65%+ gross margins, and build brands that compound.'
            : 'BrandOS Lab™（品牌科学实验室）将全球顶尖认知资本论与实战营销科学解构为 6 大高精模块。帮助出海创始人彻底砍掉自嗨指标，守死 65%+ 口袋毛利，打造能够穿越算法周期的长青高溢价品牌。'}
        </p>

        <!-- CTA Action Row -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 font-mono text-[13px] font-bold">
          <a
            href="#brandos-matrix"
            class="w-full sm:w-auto px-8 py-3.5 rounded-lg bg-gradient-to-r from-cyan-500 to-sky-500 hover:from-cyan-400 hover:to-sky-400 text-slate-950 transition-all duration-300 shadow-[0_0_30px_rgba(0,242,254,0.3)] hover:shadow-[0_0_40px_rgba(0,242,254,0.5)] flex items-center justify-center gap-2 group"
          >
            <span>{isEn ? 'Explore BrandOS™ Matrix' : '查阅 BrandOS™ 六大核心矩阵'}</span>
            <span class="group-hover:translate-y-0.5 transition-transform">↓</span>
          </a>
          <a
            href={essaysIndexHref}
            class="w-full sm:w-auto px-8 py-3.5 rounded-lg border border-[#232B3E] bg-[#111622] hover:bg-[#161D2E] hover:border-cyan-500/50 text-slate-200 transition-all duration-300 flex items-center justify-center gap-2"
          >
            <span>{isEn ? 'Read Case Notes' : '阅读深度商战研报'}</span>
            <span>→</span>
          </a>
        </div>

        <!-- Terminal-like Value Proposition Note -->
        <div class="mt-12 inline-block max-w-2xl text-left bg-[#090D16] border border-[#232B3E] rounded-xl p-4 sm:p-5 shadow-2xl">
          <div class="flex items-center gap-2 mb-2 pb-2 border-b border-[#232B3E]/80">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
            <span class="font-mono text-[11px] text-slate-500 ml-2">core_axiom_v3.2 // cognitive_capital</span>
          </div>
          <p class="font-mono text-[12px] sm:text-[13px] text-slate-300 leading-relaxed">
            <strong class="text-cyan-400 font-bold">&gt; RULE:</strong> {isEn ? 'A brand is not a logo, a tagline, or an aesthetic wrapper. A brand is an unfakeable costly signal staked in customer consciousness that mathematically lowers CAC and commands pricing authority.' : '品牌绝不是画个好看的 Logo、印几句鸡汤口号，也不是单纯把页面排得更洋气。品牌是质押在消费者心智中不可伪造的“昂贵信号”，是在算法黑盒里唯一能压低获客成本、牢牢锁死定价权的终极资产。'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Metrics Ribbon -->
  <section class="border-b border-[#232B3E] bg-[#0E131F]/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8">
        {stats.map((item) => (
          <div class="text-center p-4 border border-[#232B3E]/60 rounded-xl bg-[#111622]/50 hover:border-cyan-500/40 transition-colors">
            <div class="font-mono font-extrabold text-[28px] sm:text-[38px] text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-sky-300 leading-tight">
              {item.num}
            </div>
            <div class="font-sans text-[12px] sm:text-[13.5px] text-slate-400 mt-1 font-medium">
              {item.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive BrandOS Matrix Section -->
  <MatrixSection lang={lang} />

  <!-- Methodology Pipeline -->
  <section class="py-20 sm:py-28 border-b border-[#232B3E] bg-[#090D16] relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14">
        <div class="font-mono text-cyan-400 text-[12px] font-bold tracking-widest uppercase mb-2">
          {isEn ? 'Execution Framework' : '工程执行流水线'}
        </div>
        <h2 class="font-sans font-bold text-[28px] sm:text-[36px] text-slate-100 tracking-tight">
          {isEn ? 'How BrandOS™ Deconstructs & Rebuilds Moats' : 'BrandOS™ 是如何重构高溢价护城河的？'}
        </h2>
        <p class="font-sans text-[15px] sm:text-[16px] text-slate-400 mt-3 leading-relaxed">
          {isEn
            ? 'We discard subjective boardroom opinions in favor of four objective, data-backed operational phases.'
            : '拒绝办公室里的拍脑门脑暴，以严密逻辑将品牌建设转化为可量化、可验证的四步工程闭环。'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {methodologySteps.map((step) => (
          <div class="bg-[#111622] border border-[#232B3E] hover:border-cyan-500/50 rounded-xl p-6 flex flex-col justify-between transition-all duration-300 group hover:-translate-y-1">
            <div>
              <div class="font-mono text-[26px] font-extrabold text-cyan-400/40 group-hover:text-cyan-400 transition-colors mb-4">
                {step.num}
              </div>
              <h3 class="font-sans font-bold text-[17px] text-slate-100 mb-2.5 group-hover:text-cyan-300 transition-colors leading-snug">
                {step.title}
              </h3>
              <p class="font-sans text-[13.5px] text-slate-400 leading-relaxed">
                {step.desc}
              </p>
            </div>
            <div class="pt-4 mt-6 border-t border-[#232B3E] flex items-center gap-1 font-mono text-[11px] text-slate-500">
              <span>BrandOS™ Phase</span>
              <span class="text-cyan-400 font-bold">{step.num}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Case Studies / Deep Essays -->
  <section id="brand-notes" class="py-20 sm:py-28 border-b border-[#232B3E] bg-[#0E131F] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <div class="font-mono text-cyan-400 text-[12px] font-bold tracking-widest uppercase mb-2">
            {isEn ? 'Strategic Case Notes' : '深度研报与商战复盘'}
          </div>
          <h2 class="font-sans font-bold text-[28px] sm:text-[36px] text-slate-100 tracking-tight">
            {isEn ? 'Field Notes on Global Brand Science' : '一线品牌科学深度研报'}
          </h2>
          <p class="font-sans text-[15px] text-slate-400 mt-2 max-w-2xl">
            {isEn
              ? 'Rigorous dissections of international wins and failures to extract operational heuristics for modern founders.'
              : '以财务报表、点击流与实战数据为铁证，深度复盘国际标杆成败，提炼真正可落地的认知法则。'}
          </p>
        </div>
        <a href={essaysIndexHref} class="text-slate-200 hover:text-cyan-400 font-mono text-[13px] font-bold uppercase tracking-wider flex items-center gap-1.5 transition-colors self-start sm:self-auto">
          <span>{isEn ? `All Brand Notes (${allEssays.length})` : `全部品牌笔记 (${allEssays.length} 篇)`}</span>
          <span>→</span>
        </a>
      </div>

      <!-- Featured Essay Banner -->
      {featuredEssay && (
        <div class="mb-10 bg-[#111622] border border-[#232B3E] hover:border-cyan-500/60 rounded-2xl overflow-hidden transition-all duration-300 group hover:shadow-[0_0_35px_rgba(0,242,254,0.1)]">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
            <div class="lg:col-span-4 bg-[#090D16] border-b lg:border-b-0 lg:border-r border-[#232B3E] flex flex-col justify-between overflow-hidden relative group-hover:border-cyan-500/40 transition-colors">
              <a href={featuredHref} class="block aspect-[16/10] lg:aspect-auto lg:h-full w-full relative overflow-hidden bg-[#09090B]">
                <img 
                  src={featuredEssay.data.coverImage || (isEn ? '/images/essays/cover-zero-to-one-brand-framework-en.svg' : '/images/essays/cover-zero-to-one-brand-framework.svg')}
                  alt={featuredEssay.data.coverAlt || featuredEssay.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#111622] via-transparent to-transparent opacity-30 pointer-events-none"></div>
              </a>
            </div>

            <div class="lg:col-span-8 p-6 sm:p-8 flex flex-col justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-3 mb-4">
                  <span class={`font-mono text-[11px] font-extrabold uppercase tracking-wider px-3 py-0.5 rounded border ${featuredEssay.data.module === 'BrandOS' ? 'text-sky-300 bg-sky-950/70 border-sky-500/50' : 'text-cyan-400 bg-cyan-950/60 border-cyan-800/60'}`}>
                    {featuredEssay.data.module} • {featuredEssay.data.moduleName}
                  </span>
                  <span class="font-mono text-[11px] text-slate-400">
                    {featuredDate}
                  </span>
                  <span class="font-mono text-[11px] text-slate-600">•</span>
                  <span class="font-mono text-[11px] text-slate-400">
                    ⏱ {featuredEssay.data.readingTime}
                  </span>
                  <span class="font-mono text-[11px] text-slate-500">
                    • {isEn ? 'Author: ' : '作者：'}{featuredEssay.data.author || (isEn ? 'Ran' : 'Ran (然)')}
                  </span>
                </div>

                <h3 class="font-sans font-bold text-[22px] sm:text-[28px] text-slate-100 mb-3 group-hover:text-cyan-400 transition-colors leading-snug">
                  <a href={featuredHref}>
                    {featuredEssay.data.title}
                  </a>
                </h3>

                <p class="font-sans text-[14px] sm:text-[15.5px] text-slate-300 leading-relaxed mb-6">
                  {featuredEssay.data.description}
                </p>
              </div>

              <div class="pt-4 border-t border-[#232B3E] flex items-center justify-between">
                <div class="flex flex-wrap gap-2">
                  {(featuredEssay.data.tags || []).slice(0, 4).map((tag: string) => (
                    <span class="font-mono text-[11px] text-slate-400 bg-[#090D16] px-2.5 py-1 rounded border border-[#232B3E]">
                      #{tag}
                    </span>
                  ))}
                </div>
                <a href={featuredHref} class="font-mono text-[12px] font-bold text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  <span>{isEn ? 'Read Full Note' : '阅读完整研报'}</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- Other Essays Grid -->
      {otherEssays.length > 0 && (
        <div class={`grid grid-cols-1 md:grid-cols-2 ${otherEssays.length === 2 || otherEssays.length === 4 ? 'lg:grid-cols-2' : 'lg:grid-cols-3'} gap-6 sm:gap-8 mt-8`}>
          {otherEssays.map((essay) => (
            <EssayCard essay={essay} lang={lang} />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Ecosystem / Advisory Pillars -->
  <section class="py-20 sm:py-28 border-b border-[#232B3E] bg-[#090D16]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="font-mono text-cyan-400 text-[12px] font-bold tracking-widest uppercase mb-2">
          {isEn ? 'Advisory & Capabilities' : '能力矩阵与咨询服务'}
        </div>
        <h2 class="font-sans font-bold text-[28px] sm:text-[36px] text-slate-100 tracking-tight">
          {isEn ? 'Built for High-Growth Global Leaders' : '专为追求高增长、高溢价的出海领航者打造'}
        </h2>
        <p class="font-sans text-[15px] sm:text-[16px] text-slate-400 mt-3 leading-relaxed">
          {isEn
            ? 'Whether you need a total brand architectural audit or dedicated executive sparring, BrandOS Lab™ delivers measurable cognitive dominance.'
            : '无论是需要对现有出海业务进行全景品牌架构重构，还是核心团队的高阶认知对齐，BrandOS Lab™ 均提供不可伪造的专业战力。'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {ecosystemPillars.map((pillar) => (
          <div class="bg-[#111622] border border-[#232B3E] hover:border-cyan-500/50 rounded-xl p-8 flex flex-col justify-between transition-all duration-300 group hover:-translate-y-1">
            <div>
              <div class="font-mono text-[11px] font-bold text-cyan-400 uppercase tracking-wider mb-3">
                {pillar.category}
              </div>
              <h3 class="font-sans font-bold text-[20px] text-slate-100 mb-3 group-hover:text-cyan-300 transition-colors">
                {pillar.title}
              </h3>
              <p class="font-sans text-[14px] text-slate-400 leading-relaxed">
                {pillar.desc}
              </p>
            </div>
            <div class="pt-6 mt-6 border-t border-[#232B3E]">
              <span class="font-mono text-[11px] text-slate-500">BrandOS™ Core Capability</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA / Contact Section -->
  <section class="py-20 sm:py-28 relative overflow-hidden bg-gradient-to-b from-[#0E131F] to-[#090D16]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-500/30 bg-cyan-950/40 text-cyan-300 font-mono text-[11px] font-bold tracking-wider uppercase mb-6">
        <span>{isEn ? 'Executive Advisory Retainer' : '高阶品牌系统咨询与私享陪跑'}</span>
      </div>

      <h2 class="font-sans font-extrabold text-[30px] sm:text-[44px] text-slate-100 tracking-tight leading-tight mb-6">
        {isEn ? (
          <>
            Ready to Build a Brand That <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-sky-300">
              Owns Unconditional Pricing Power?
            </span>
          </>
        ) : (
          <>
            准备好为你的出海业务 <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-sky-300">
              建立具有无条件定价权的高溢价系统了吗？
            </span>
          </>
        )}
      </h2>

      <p class="font-sans text-[15px] sm:text-[17px] text-slate-300 leading-relaxed max-w-2xl mx-auto mb-10">
        {isEn
          ? 'We take on a strictly limited number of strategic brand architecture clients each quarter. Let’s talk about your unit economics, category entry points, and competitive moats.'
          : '为确保绝对的深度与交付品质，我们每季度仅开放极少数品牌架构咨询与深度陪跑席位。欢迎带着你当前的单体经济模型、毛利痛点与品类困局，与我们直面探讨。'}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 font-mono text-[13px] font-bold">
        <a
          href={mailtoHref}
          class="w-full sm:w-auto px-8 py-4 rounded-lg bg-gradient-to-r from-cyan-500 to-sky-500 hover:from-cyan-400 hover:to-sky-400 text-slate-950 transition-all duration-300 shadow-[0_0_35px_rgba(0,242,254,0.3)] hover:shadow-[0_0_45px_rgba(0,242,254,0.5)] flex items-center justify-center gap-2 group"
        >
          <span>{isEn ? 'Initiate Private Discussion' : '预约私密战略研讨'}</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <a
          href={getLocalizedPath('/about', lang)}
          class="w-full sm:w-auto px-8 py-4 rounded-lg border border-[#232B3E] bg-[#111622] hover:bg-[#161D2E] hover:border-cyan-500/50 text-slate-200 transition-all duration-300 flex items-center justify-center gap-2"
        >
          <span>{isEn ? 'About the Founder & Lab' : '了解实验室与创始人背景'}</span>
          <span>→</span>
        </a>
      </div>

      <div class="mt-8 font-mono text-[11px] text-slate-500">
        {isEn ? 'Direct Founder Inquiries: ranzhongus@icloud.com' : '创始人直联通道：ranzhongus@icloud.com'}
      </div>
    </div>
  </section>
</Layout>
