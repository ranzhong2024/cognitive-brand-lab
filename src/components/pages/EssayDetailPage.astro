---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getEssaySlug, getLocalizedPath, type Lang } from '../../utils/i18n';

interface Props {
  essay: CollectionEntry<'essays'>;
  lang?: Lang;
}

const { essay, lang = 'zh' } = Astro.props;
const isEn = lang === 'en';
const { Content, headings } = await render(essay);

const slug = getEssaySlug(essay);
const essayPath = getLocalizedPath(`/essays/${slug}`, lang);
const essaysHomePath = getLocalizedPath('/essays', lang);
const homePath = getLocalizedPath('/', lang);
const aboutPath = getLocalizedPath('/about', lang);

const allEssays = (await getCollection('essays')).filter((e) => e.data.lang === lang);
const relatedEssays = allEssays.filter((e) => e.id !== essay.id).slice(0, 2);

const moduleColors: Record<string, { badge: string; border: string; accent: string }> = {
  M1: { badge: 'text-cyan-400 bg-cyan-950/60 border-cyan-800/60', border: 'border-cyan-500/40', accent: '#00F2FE' },
  M2: { badge: 'text-indigo-400 bg-indigo-950/60 border-indigo-800/60', border: 'border-indigo-500/40', accent: '#818CF8' },
  M3: { badge: 'text-emerald-400 bg-emerald-950/60 border-emerald-800/60', border: 'border-emerald-500/40', accent: '#10B981' },
  M4: { badge: 'text-amber-400 bg-amber-950/60 border-amber-800/60', border: 'border-amber-500/40', accent: '#F59E0B' },
  M5: { badge: 'text-rose-400 bg-rose-950/60 border-rose-800/60', border: 'border-rose-500/40', accent: '#F43F5E' },
  M6: { badge: 'text-purple-400 bg-purple-950/60 border-purple-800/60', border: 'border-purple-500/40', accent: '#A855F7' },
};

const style = moduleColors[essay.data.module] || moduleColors.M1;
const publishDateIso = essay.data.pubDate ? new Date(essay.data.pubDate).toISOString() : new Date().toISOString();

const essayUrl = `https://ranbrandos.com${essayPath}`;
const articleSections = headings ? headings.map((h) => h.text) : [];

const articleSchema: Record<string, any> = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["TechArticle", "ScholarlyArticle", "BlogPosting"],
      "@id": `${essayUrl}#article`,
      "headline": essay.data.title,
      "description": essay.data.description,
      "image": essay.data.coverImage ? `https://ranbrandos.com${essay.data.coverImage}` : "https://ranbrandos.com/brandos-logo.svg",
      "datePublished": publishDateIso,
      "dateModified": publishDateIso,
      "mainEntityOfPage": essayUrl,
      "inLanguage": isEn ? "en" : "zh-CN",
      "author": {
        "@type": "Person",
        "@id": "https://ranbrandos.com/#founder",
        "name": isEn ? "Ran" : "Ran (然)",
        "jobTitle": "Principal BrandOS Architect & Founder",
        "url": `https://ranbrandos.com${aboutPath}`
      },
      "publisher": {
        "@type": "Organization",
        "@id": "https://ranbrandos.com/#organization",
        "name": isEn ? "BrandOS Lab™" : "品牌科学实验室™ (BRANDOS LAB™)",
        "logo": {
          "@type": "ImageObject",
          "url": "https://ranbrandos.com/brandos-logo.svg"
        }
      },
      "about": {
        "@id": `https://ranbrandos.com/#term-${essay.data.module.toLowerCase()}`
      },
      "articleSection": articleSections,
      "keywords": [
        essay.data.module,
        essay.data.moduleName,
        isEn ? "Global DTC Brand Strategy" : "出海品牌",
        "BrandOS",
        isEn ? "Brand Science" : "品牌科学",
        ...(essay.data.tags || [])
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${essayUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": isEn ? "Home" : "首页",
          "item": `https://ranbrandos.com${homePath}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": isEn ? "Brand Notes" : "品牌笔记 (Brand Notes)",
          "item": `https://ranbrandos.com${essaysHomePath}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${essay.data.module}: ${essay.data.title}`,
          "item": essayUrl
        }
      ]
    }
  ]
};

if (essay.data.faqs && essay.data.faqs.length > 0) {
  (articleSchema["@graph"] as any[]).push({
    "@type": "FAQPage",
    "@id": `${essayUrl}#faq`,
    "inLanguage": isEn ? "en" : "zh-CN",
    "mainEntity": essay.data.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer,
      },
    })),
  });
}
---

<Layout
  lang={lang}
  title={`${essay.data.title} | ${isEn ? 'Brand Notes • BrandOS Lab™' : '品牌笔记 • 品牌科学实验室™'}`}
  description={essay.data.description}
  image={essay.data.coverImage}
  type="article"
  publishDate={publishDateIso}
  customSchema={articleSchema}
>
  <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-cyan-400 via-indigo-500 to-emerald-400 z-[100] transition-all duration-75" style="width: 0%;"></div>

  <div class="max-w-6xl mx-auto px-5 md:px-8 py-12 sm:py-20 relative z-10">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 font-mono text-xs text-slate-500 uppercase tracking-widest mb-8">
      <a href={homePath} class="hover:text-cyan-400 transition-colors">BRANDOS LAB™</a>
      <span>/</span>
      <a href={essaysHomePath} class="hover:text-cyan-400 transition-colors">{isEn ? 'BRAND NOTES' : '品牌笔记'}</a>
      <span>/</span>
      <span class="text-cyan-400">{essay.data.module}</span>
    </nav>

    <!-- Article Header -->
    <header class="border-b border-[#232B3E] pb-12 mb-14">
      <div class="flex flex-wrap items-center gap-3 mb-5">
        <span class={`font-mono text-xs font-extrabold px-3 py-1 rounded uppercase tracking-wider border ${style.badge}`}>
          {essay.data.module} • {essay.data.moduleName}
        </span>
        <span class="font-mono text-xs text-slate-400">
          ⏱ {isEn ? 'Read Time:' : '预计阅读：'}{essay.data.readingTime}
        </span>
        <span class="font-mono text-xs text-slate-500">
          • {isEn ? 'Published:' : '发布日期：'}{publishDateIso.slice(0, 10)}
        </span>
        <span class="font-mono text-xs text-slate-400 ml-auto">
          {isEn ? 'Author: ' : '作者：'}<strong class="text-slate-200">{essay.data.author || (isEn ? 'Ran' : 'Ran (然)')}</strong>
        </span>
      </div>

      <h1 class="font-sans font-black text-2xl sm:text-4xl md:text-5xl text-slate-100 leading-tight mb-6 tracking-tight">
        {essay.data.title}
      </h1>

      <div class="bg-[#111622] border-l-4 border-cyan-400 p-5 sm:p-6 rounded-r-2xl border-y border-r border-[#232B3E] shadow-xl">
        <div class="font-mono text-xs text-cyan-400 font-bold uppercase tracking-wider mb-2 flex items-center gap-2">
          <span>{isEn ? '💡 EXECUTIVE BRIEF' : '💡 本篇核心导读'}</span>
        </div>
        <p class="font-sans text-sm sm:text-base text-slate-200 leading-relaxed">
          {essay.data.description}
        </p>
      </div>
    </header>

    <!-- Main Content Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      {headings && headings.length > 0 && (
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-[#111622] border border-[#232B3E] p-5 rounded-2xl max-h-[calc(100vh-120px)] overflow-y-auto shadow-lg">
            <div class="font-mono text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 pb-2 border-b border-[#232B3E] flex items-center justify-between">
              <span>{isEn ? '📑 CONTENTS' : '📑 观察目录'}</span>
              <span class="text-xs text-cyan-400">TOC</span>
            </div>
            <nav class="space-y-2 font-sans text-xs">
              {headings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  class={`block py-1 hover:text-cyan-400 transition-colors leading-relaxed ${
                    h.depth === 4
                      ? 'pl-6 text-[11px] text-slate-400'
                      : h.depth === 3
                        ? 'pl-3 text-xs text-slate-300'
                        : 'pt-1.5 font-semibold text-slate-200'
                  }`}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )}

      <article class={`${headings && headings.length > 0 ? 'lg:col-span-9' : 'lg:col-span-12'} max-w-[76ch] mx-auto w-full`}>
        <div class="prose-custom">
          <Content />
        </div>

        <!-- Author Dossier Card -->
        <div class="mt-16 pt-8 border-t border-[#232B3E] bg-[#111622] p-6 sm:p-8 rounded-2xl flex flex-col sm:flex-row items-center gap-6 shadow-xl border border-[#232B3E]">
          <div class="w-16 h-16 rounded-2xl bg-[#09090B] border-2 border-cyan-400 flex items-center justify-center font-mono font-black text-xl text-cyan-400 flex-shrink-0 shadow-[0_0_20px_rgba(0,242,254,0.2)]">
            R
          </div>
          <div>
            <div class="flex items-center gap-3 mb-1.5">
              <h4 class="font-bold text-lg text-slate-100">{isEn ? 'Ran' : 'Ran (然)'}</h4>
              <span class="font-mono text-xs text-cyan-400 font-semibold bg-cyan-950/60 px-2 py-0.5 rounded border border-cyan-800/40">
                {isEn ? 'Principal BrandOS™ Architect' : 'BrandOS™ 首席架构师'}
              </span>
            </div>
            <p class="text-sm text-slate-400 leading-relaxed font-sans">
              {isEn
                ? 'Founder of BrandOS Lab™. M.S. in Digital Marketing (North America), IIBA CBAP Certified Business Analysis Professional, and Google Data Analytics & Digital Marketing certified practitioner engineering high-margin global DTC brands.'
                : '品牌科学实验室™ 发起人。北美数字营销硕士，IIBA CBAP 国际注册商业分析师，谷歌数字营销与数据分析认证。专注将商业分析、认知心理学与因果推断深度工程化，为中国出海企业铸造全球高溢价品牌。'}
            </p>
          </div>
        </div>

        <!-- Bottom Consultation Box -->
        <div class="mt-8 bg-gradient-to-br from-cyan-950/40 via-[#111622] to-[#111622] border border-cyan-500/40 p-8 rounded-2xl flex flex-col sm:flex-row justify-between items-center gap-6 shadow-2xl">
          <div>
            <h3 class="font-sans font-bold text-xl text-slate-100 mb-2">
              {isEn
                ? 'Ready to install BrandOS™ across your DTC brand?'
                : '想为你的出海品牌装载这套 BrandOS™ 操作系统？'}
            </h3>
            <p class="font-sans text-sm text-slate-300">
              {isEn
                ? 'Move beyond paid-traffic arbitrage and commodity discounting. Email founder Ran directly to architect your brand equity and pricing power.'
                : '拒绝传统买量内卷与低价代工，直接与发起人 Ran 探讨如何重构你的出海品牌资产与高溢价定价权。'}
            </p>
          </div>
          <a
            href="mailto:ranzhongus@icloud.com"
            class="px-6 py-3.5 bg-cyan-400 hover:bg-cyan-300 text-[#09090B] font-mono font-black text-xs uppercase tracking-wider rounded-xl whitespace-nowrap shadow-lg shadow-cyan-400/20 transition-all flex items-center gap-2"
          >
            <span>{isEn ? 'Consult Founder' : '马上咨询'}</span>
            <span>✉</span>
          </a>
        </div>

        {relatedEssays && relatedEssays.length > 0 && (
          <div class="mt-14 pt-8 border-t border-[#232B3E]">
            <h4 class="font-mono text-xs font-bold text-slate-400 uppercase tracking-widest mb-6">
              {isEn ? '📚 RECOMMENDED READING' : '📚 延伸研读 (RECOMMENDED ESSAYS)'}
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedEssays.map((rel) => (
                <a
                  href={getLocalizedPath(`/essays/${getEssaySlug(rel)}`, lang)}
                  class="bg-[#111622] border border-[#232B3E] hover:border-cyan-400 p-5 rounded-xl transition-all group block"
                >
                  <div class="font-mono text-xs text-cyan-400 font-bold uppercase mb-1">
                    {rel.data.module} • {rel.data.moduleName}
                  </div>
                  <div class="font-sans font-bold text-sm text-slate-200 group-hover:text-cyan-400 transition-colors line-clamp-2 leading-snug">
                    {rel.data.title}
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="mt-12 text-center">
          <a
            href={essaysHomePath}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#111622] border border-[#232B3E] hover:border-cyan-400 text-slate-300 hover:text-white font-mono text-xs font-bold uppercase transition-colors"
          >
            <span>{isEn ? '← Back to All Brand Notes' : '← 返回全部品牌笔记'}</span>
          </a>
        </div>
      </article>
    </div>
  </div>

  <script is:inline>
    function setupReadingProgress() {
      const updateBar = () => {
        const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        const bar = document.getElementById('reading-progress');
        if (bar) bar.style.width = scrolled + '%';
      };

      window.addEventListener('scroll', updateBar, { passive: true });
    }

    setupReadingProgress();
    document.addEventListener('astro:page-load', setupReadingProgress);
  </script>
</Layout>