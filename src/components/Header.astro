---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="bg-surface/90 backdrop-blur-md border-b border-[#E5E7EB] sticky top-0 z-50 w-full transition-all duration-200">
  <div class="flex justify-between items-center w-full px-6 md:px-12 py-4 max-w-5xl mx-auto">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <span class="font-serif text-[22px] font-bold text-primary tracking-tight group-hover:text-accent-blue transition-colors">
        Cognitive Brand Lab
      </span>
      <span class="hidden sm:inline-block font-mono text-[9px] font-bold uppercase tracking-[0.2em] text-accent-blue px-2 py-0.5 border border-accent-blue/30 bg-blue-50/50 rounded-sm">
        RAN BRAND OS™
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex gap-8 items-center font-mono text-[11px] font-bold uppercase tracking-[0.15em]">
      <a 
        href="/#brand-os" 
        class={`transition-colors pb-0.5 ${currentPath === '/modules' ? 'text-accent-blue font-extrabold border-b-2 border-accent-blue' : 'text-secondary hover:text-primary'}`}
      >
        系统架构 (OS MAP)
      </a>
      <a 
        href="/essays" 
        class={`transition-colors pb-0.5 ${currentPath.startsWith('/essays') ? 'text-accent-blue font-extrabold border-b-2 border-accent-blue' : 'text-secondary hover:text-primary'}`}
      >
        实战内参 (ESSAYS)
      </a>
      <a 
        href="/about" 
        class={`transition-colors pb-0.5 ${currentPath === '/about' ? 'text-accent-blue font-extrabold border-b-2 border-accent-blue' : 'text-secondary hover:text-primary'}`}
      >
        关于发起人 (ABOUT)
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-4">
      <a 
        href="mailto:contact@ranshi.com" 
        class="hidden sm:inline-flex items-center gap-1.5 font-mono text-[11px] font-bold text-white bg-[#0a192f] hover:bg-accent-blue px-3.5 py-1.5 rounded-sm transition-all duration-200 uppercase tracking-wider shadow-sm"
      >
        <span>直接联络</span>
        <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
      </a>
    </div>
  </div>
</header>
