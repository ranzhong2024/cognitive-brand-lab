---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 w-full bg-[#09090B]/90 backdrop-blur-md border-b border-[#232B3E] transition-all duration-200">
  <div class="flex justify-between items-center w-full px-5 md:px-12 py-3 max-w-6xl mx-auto">
    <!-- Brand Identity & Monogram -->
    <a href="/" class="flex items-center gap-3.5 group">
      <!-- High-Precision Solid B Monogram SVG -->
      <div class="w-9 h-9 rounded-lg border border-[#27272A] bg-[#09090B] flex items-center justify-center group-hover:border-cyan-400 group-hover:shadow-[0_0_15px_rgba(0,242,254,0.3)] transition-all duration-300 p-1">
        <svg viewBox="0 0 48 48" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M 10 8 H 28 C 34.5 8 38.5 11.5 38.5 17 C 38.5 21.5 35.5 24 31 24.5 C 36.5 25.2 39.5 28.5 39.5 33.5 C 39.5 39.5 34.5 43 28 43 H 10 V 8 Z M 17 14 V 22.5 H 27 C 29.5 22.5 31.5 21 31.5 18.2 C 31.5 15.5 29.5 14 27 14 H 17 Z M 17 28.5 V 37 H 27.5 C 30.5 37 32.5 35.2 32.5 32.7 C 32.5 30.2 30.5 28.5 27.5 28.5 H 17 Z" fill="#FAFAFA"/>
          <rect x="8" y="24" width="18" height="2.5" fill="#09090B"/>
          <circle cx="26" cy="25.25" r="3.5" fill="#00F2FE"/>
        </svg>
      </div>

      <div class="flex flex-col">
        <span class="font-sans font-extrabold text-[17px] sm:text-[19px] text-slate-100 tracking-tight group-hover:text-cyan-400 transition-colors leading-none">
          BrandOS Lab
        </span>
        <span class="font-mono text-[9.5px] font-bold uppercase tracking-[0.2em] text-cyan-400 mt-1">
          品牌科学实验室™
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex gap-8 items-center font-mono text-[12px] font-bold uppercase tracking-[0.15em]">
      <a 
        href="/#brandos-matrix" 
        class="text-slate-300 hover:text-cyan-400 transition-colors py-1"
      >
        BrandOS™
      </a>
      <a 
        href="/essays" 
        class={`transition-colors py-1 ${currentPath.startsWith('/essays') ? 'text-cyan-400 border-b border-cyan-400' : 'text-slate-300 hover:text-slate-100'}`}
      >
        品牌笔记 (BRAND NOTES)
      </a>
      <a 
        href="/about" 
        class={`transition-colors py-1 ${currentPath === '/about' ? 'text-cyan-400 border-b border-cyan-400' : 'text-slate-300 hover:text-slate-100'}`}
      >
        关于实验室 (ABOUT)
      </a>
    </nav>

    <!-- Header Actions (Desktop Direct CTA + Mobile Hamburger) -->
    <div class="flex items-center gap-3">
      <a 
        href="/essays" 
        class="hidden sm:inline-flex items-center gap-2 font-mono text-[11px] font-bold text-[#09090B] bg-slate-100 hover:bg-cyan-400 px-4 py-2 rounded transition-all duration-200 uppercase tracking-wider shadow-sm"
      >
        <span>查阅品牌笔记 ↗</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="open-drawer-btn"
        class="md:hidden w-11 h-11 rounded bg-[#111622] border border-[#232B3E] text-slate-200 hover:text-white flex items-center justify-center text-[18px]"
        aria-label="Open Navigation Menu"
      >
        ☰
      </button>
    </div>
  </div>
</header>
