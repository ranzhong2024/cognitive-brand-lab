<!-- Mobile Drawer Overlay -->
<div id="mobile-drawer-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[90] opacity-0 pointer-events-none transition-opacity duration-300"></div>

<!-- Mobile Drawer Container -->
