        </div>
      </div>
      <button id="close-drawer-btn" class="w-11 h-11 rounded-full bg-[#111622] border border-[#232B3E] text-slate-300 hover:text-white flex items-center justify-center text-[18px]">
        ✕
      </button>
    </div>

    <!-- Main Navigation Links -->
    <nav class="space-y-4 mb-8">
      <a href="/#brandos-matrix" class="drawer-link flex items-center justify-between p-3 rounded-lg bg-[#111622] border border-[#232B3E] text-slate-200 font-bold text-[15px]">
        <span>⚡ BrandOS 操作系统</span>
        <span class="text-cyan-400 font-mono text-[12px]">M1–M6 →</span>
      </a>
      <a href="/essays" class="drawer-link flex items-center justify-between p-3 rounded-lg bg-[#111622] border border-[#232B3E] text-slate-200 font-bold text-[15px]">
        <span>📑 品牌笔记 (BRAND NOTES)</span>
        <span class="text-cyan-400 font-mono text-[12px]">专著库 →</span>
      </a>
      <a href="/about" class="drawer-link flex items-center justify-between p-3 rounded-lg bg-[#111622] border border-[#232B3E] text-slate-200 font-bold text-[15px]">
        <span>👤 关于实验室 (ABOUT)</span>
        <span class="text-cyan-400 font-mono text-[12px]">RANBOK →</span>
      </a>
    </nav>

    <!-- M1-M6 Fast Links -->
    <div class="mb-8">
      <div class="font-mono text-[11px] font-bold text-slate-500 uppercase tracking-widest mb-3">
        BrandOS™ 模块速查
      </div>
      <div class="grid grid-cols-2 gap-2 text-[12px] font-mono">
        <a href="/modules/m1-brand-foundations" class="p-2 rounded bg-[#111622]/60 border border-[#232B3E] text-slate-300 hover:text-cyan-400">
          M1 勘测心智
        </a>
        <a href="/modules/m2-behavioral-science" class="p-2 rounded bg-[#111622]/60 border border-[#232B3E] text-slate-300 hover:text-indigo-400">
          M2 信任质押
        </a>
        <a href="/modules/m3-strategic-pricing" class="p-2 rounded bg-[#111622]/60 border border-[#232B3E] text-slate-300 hover:text-emerald-400">
          M3 价值定价
        </a>
        <a href="/modules/m4-algorithmic-resonance" class="p-2 rounded bg-[#111622]/60 border border-[#232B3E] text-slate-300 hover:text-amber-400">
          M4 算法共振
        </a>
        <a href="/modules/m5-conversion-engineering" class="p-2 rounded bg-[#111622]/60 border border-[#232B3E] text-slate-300 hover:text-rose-400">
          M5 极速转化
        </a>
        <a href="/modules/m6-compounding-retention" class="p-2 rounded bg-[#111622]/60 border border-[#232B3E] text-slate-300 hover:text-purple-400">
          M6 复利留存
