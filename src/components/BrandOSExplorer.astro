    <button class="os-tab-btn p-3 rounded-lg border border-[#232B3E] bg-[#111622] text-left transition-all hover:border-slate-500 group" data-tab="m5">
      <div class="flex items-center justify-between font-mono text-[11px] mb-1">
        <span class="font-black text-rose-400">05</span>
        <span class="text-rose-300 text-[10px] uppercase">CONVERT</span>
      </div>
      <div class="font-bold text-slate-200 text-[14px]">M5 极速转化</div>
