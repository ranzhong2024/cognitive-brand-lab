<section class="max-w-6xl mx-auto px-5 md:px-8 py-20 relative z-10 border-b border-[#232B3E]" id="brandos-matrix">
  <!-- Section Title -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-[#232B3E] pb-6">
    <div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-cyan-950/40 border border-cyan-800/40 rounded-full font-mono text-[11px] font-bold text-cyan-400 uppercase tracking-[0.2em] mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        INTERACTIVE SYSTEM EXPLORER
      </div>
      <h2 class="font-sans font-extrabold text-[28px] sm:text-[42px] text-slate-100 leading-tight">
        BrandOS™ 品牌操作系统建设
      </h2>
    </div>
    <p class="text-slate-400 text-[14px] sm:text-[15px] mt-3 md:mt-0 font-sans max-w-md">
      点击下方 6 大阶段，切换查看各模块的<span class="text-cyan-400 font-semibold">可视化科学模型</span>、真实实战战例与量化财务战果。
    </p>
  </div>

  <!-- Interactive 6-Tab Stepper -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 mb-8">
    <button class="os-tab-btn active p-3 rounded-lg border border-cyan-500 bg-cyan-950/30 text-left transition-all group" data-tab="m1">
      <div class="flex items-center justify-between font-mono text-[11px] mb-1">
        <span class="font-black text-cyan-400">01</span>
        <span class="text-cyan-300 text-[10px] uppercase">RADAR</span>
      </div>
      <div class="font-bold text-slate-100 text-[14px]">M1 勘测心智</div>
      <div class="text-[11px] text-slate-400 mt-0.5 truncate">EcoFlow 暴风雪应急</div>
    </button>

    <button class="os-tab-btn p-3 rounded-lg border border-[#232B3E] bg-[#111622] text-left transition-all hover:border-slate-500 group" data-tab="m2">
      <div class="flex items-center justify-between font-mono text-[11px] mb-1">
        <span class="font-black text-indigo-400">02</span>
        <span class="text-indigo-300 text-[10px] uppercase">TRUST</span>
      </div>
      <div class="font-bold text-slate-200 text-[14px]">M2 立住人设</div>
      <div class="text-[11px] text-slate-400 mt-0.5 truncate">Dyson 5127次打样</div>
    </button>

    <button class="os-tab-btn p-3 rounded-lg border border-[#232B3E] bg-[#111622] text-left transition-all hover:border-slate-500 group" data-tab="m3">
      <div class="flex items-center justify-between font-mono text-[11px] mb-1">
        <span class="font-black text-emerald-400">03</span>
        <span class="text-emerald-300 text-[10px] uppercase">PRICING</span>
      </div>
      <div class="font-bold text-slate-200 text-[14px]">M3 价值定价</div>
      <div class="text-[11px] text-slate-400 mt-0.5 truncate">YETI 65%+ 战略毛利</div>
    </button>

    <button class="os-tab-btn p-3 rounded-lg border border-[#232B3E] bg-[#111622] text-left transition-all hover:border-slate-500 group" data-tab="m4">
      <div class="flex items-center justify-between font-mono text-[11px] mb-1">
        <span class="font-black text-amber-400">04</span>
        <span class="text-amber-300 text-[10px] uppercase">ALGO</span>
      </div>
      <div class="font-bold text-slate-200 text-[14px]">M4 算法共振</div>
      <div class="text-[11px] text-slate-400 mt-0.5 truncate">HexClad 白标买爆</div>
