---
interface Props {
  number: string;
  title: string;
  desc: string;
}

const { number, title, desc } = Astro.props;
---

<div class="bg-slate-900 border border-slate-800 p-6 rounded-lg">
  <div class="font-mono text-xs font-bold text-cyan-400 mb-2">SECTION {number}</div>
  <h3 class="font-serif text-lg font-bold text-slate-100 mb-2">{title}</h3>
  <p class="font-sans text-sm text-slate-400 leading-relaxed">{desc}</p>
</div>
