---
const siteUrl = 'https://ranbrandos.com';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "品牌科学实验室™ • BRANDOS LAB™",
      "alternateName": ["BRANDOS LAB", "BrandOS Laboratory", "Cognitive Brand Lab"],
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/brandos-logo.svg`,
        "caption": "BrandOS Lab - The Cognitive Capital & Brand Architecture Science Lab"
      },
      "founder": {
        "@type": "Person",
        "@id": `${siteUrl}/about/#founder`,
        "name": "Ran (然)",
        "jobTitle": "Principal Investigator & Brand Architect",
        "description": "Cross-border growth strategist, CBAP Certified Business Analysis Professional, specializing in empirical brand science, behavioural economics, and causal retention architecture.",
        "url": `${siteUrl}/about`
      },
      "description": "专为中国出海企业打造的高阶品牌工程操作系统。融合商业分析(CBAP)、行为经济学、诺贝尔信息经济学与因果数据科学，击碎买量内卷，构建不可动摇的心智资产。",
      "knowsAbout": [
        "Brand Equity Architecture",
        "Empirical Marketing Science (Ehrenberg-Bass Institute)",
        "Spence Costly Signaling Theory",
        "Category Entry Points (CEPs)",
        "Jobs-To-Be-Done (JTBD)",
        "Good-Better-Best (GBB) Strategic Pricing",
        "Conversion Rate Optimization (MECLABS)",
        "Causal Incrementality & Retention Engineering"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "品牌科学实验室™ • BRANDOS LAB™",
      "publisher": {
        "@id": `${siteUrl}/#organization`
      },
      "inLanguage": "zh-CN"
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
